{
  "Resources": {
    "LG": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/pf/tpf"
      }
    },
    "TR": {
      "Type": "AWS::Logs::Transformer",
      "Properties": {
        "LogGroupIdentifier": {
          "Ref": "LG"
        },
        "TransformerConfig": [
          {
            "ParseJSON": {}
          },
          {
            "AddKeys": {
              "Entries": [
                {
                  "Key": "env",
                  "Value": "prod"
                }
              ]
            }
          }
        ]
      }
    }
  }
}
