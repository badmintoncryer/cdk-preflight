{
  "Resources": {
    "LG": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {}
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "logs.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    },
    "SF": {
      "Type": "AWS::Logs::SubscriptionFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "LG"
        },
        "FilterPattern": "",
        "DestinationArn": {
          "Fn::Sub": "arn:aws:kinesis:${AWS::Region}:${AWS::AccountId}:stream/app-stream"
        },
        "RoleArn": {
          "Fn::GetAtt": [
            "Role",
            "Arn"
          ]
        }
      }
    }
  }
}
