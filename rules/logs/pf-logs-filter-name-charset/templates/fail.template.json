{
  "Resources": {
    "LG": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/pf/fnc"
      }
    },
    "MF": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "LG"
        },
        "FilterPattern": "{ $.level = \"ERROR\" }",
        "MetricTransformations": [
          {
            "MetricName": "pf",
            "MetricNamespace": "PF",
            "MetricValue": "1"
          }
        ],
        "FilterName": "pf:filter"
      }
    }
  }
}
