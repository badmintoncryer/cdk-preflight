{
  "Resources": {
    "LG": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/pf/anomaly-detector",
        "LogGroupClass": "STANDARD"
      }
    },
    "Detector": {
      "Type": "AWS::Logs::LogAnomalyDetector",
      "Properties": {
        "DetectorName": "pf-detector",
        "LogGroupArnList": [
          {
            "Fn::GetAtt": [
              "LG",
              "Arn"
            ]
          }
        ]
      }
    }
  }
}
