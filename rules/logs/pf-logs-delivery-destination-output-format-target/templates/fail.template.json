{
  "Resources": {
    "Target": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/pf/delivery-ddoft"
      }
    },
    "Dest": {
      "Type": "AWS::Logs::DeliveryDestination",
      "Properties": {
        "Name": "pf-ddoft",
        "DestinationResourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/pf/delivery-ddoft:*"
        },
        "OutputFormat": "parquet"
      }
    }
  }
}
