{
  "Resources": {
    "LG": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/pf/metric-filter",
        "LogGroupClass": "INFREQUENT_ACCESS"
      }
    },
    "Filter": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "LG"
        },
        "FilterPattern": "{ $.level = \"ERROR\" }",
        "MetricTransformations": [
          {
            "MetricName": "pf",
            "MetricNamespace": "PF",
            "MetricValue": "1"
          }
        ]
      }
    }
  }
}
