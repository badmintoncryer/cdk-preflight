{
  "Resources": {
    "R": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": false,
          "Origins": [
            {
              "Id": "o1",
              "DomainName": "b.s3.us-east-1.amazonaws.com",
              "S3OriginConfig": {
                "OriginAccessIdentity": "origin-access-identity/cloudfront/E2EXAMPLE"
              },
              "OriginAccessControlId": "E1EXAMPLE"
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "o1",
            "ViewerProtocolPolicy": "allow-all",
            "ForwardedValues": {
              "QueryString": false
            }
          }
        }
      }
    }
  }
}
