{
  "Resources": {
    "R": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": false,
          "Origins": [
            {
              "Id": "o1",
              "DomainName": "example.com",
              "CustomOriginConfig": {
                "OriginProtocolPolicy": "http-only"
              },
              "OriginCustomHeaders": [
                {
                  "HeaderName": "X-Custom",
                  "HeaderValue": "x"
                }
              ]
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "o1",
            "ViewerProtocolPolicy": "allow-all",
            "ForwardedValues": {
              "QueryString": false
            }
          }
        }
      }
    }
  }
}
