{
  "Resources": {
    "R": {
      "Type": "AWS::CloudFront::ContinuousDeploymentPolicy",
      "Properties": {
        "ContinuousDeploymentPolicyConfig": {
          "Enabled": true,
          "StagingDistributionDnsNames": [
            "a.cloudfront.net"
          ],
          "TrafficConfig": {
            "Type": "SingleWeight",
            "SingleHeaderConfig": {
              "Header": "aws-cf-cd-x",
              "Value": "v"
            }
          }
        }
      }
    }
  }
}
