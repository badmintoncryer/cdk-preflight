{
  "Resources": {
    "R": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": false,
          "Origins": [
            {
              "Id": "o1",
              "DomainName": "example.com",
              "CustomOriginConfig": {
                "OriginProtocolPolicy": "http-only"
              }
            },
            {
              "Id": "o2",
              "DomainName": "other.example.com",
              "CustomOriginConfig": {
                "OriginProtocolPolicy": "http-only"
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "o1",
            "ViewerProtocolPolicy": "allow-all",
            "ForwardedValues": {
              "QueryString": false
            }
          },
          "OriginGroups": {
            "Quantity": 1,
            "Items": [
              {
                "Id": "og1",
                "FailoverCriteria": {
                  "StatusCodes": {
                    "Quantity": 1,
                    "Items": [
                      418
                    ]
                  }
                },
                "Members": {
                  "Quantity": 2,
                  "Items": [
                    {
                      "OriginId": "o1"
                    },
                    {
                      "OriginId": "o2"
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    }
  }
}
