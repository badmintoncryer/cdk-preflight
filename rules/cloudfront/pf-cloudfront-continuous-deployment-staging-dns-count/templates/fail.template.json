{
  "Resources": {
    "R": {
      "Type": "AWS::CloudFront::ContinuousDeploymentPolicy",
      "Properties": {
        "ContinuousDeploymentPolicyConfig": {
          "Enabled": true,
          "StagingDistributionDnsNames": [
            "a.cloudfront.net",
            "b.cloudfront.net"
          ],
          "TrafficConfig": {
            "Type": "SingleWeight",
            "SingleWeightConfig": {
              "Weight": 0.1
            }
          }
        }
      }
    }
  }
}
