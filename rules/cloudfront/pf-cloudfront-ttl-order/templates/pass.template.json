{
  "Resources": {
    "Dist": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "DefaultCacheBehavior": {
            "TargetOriginId": "origin1",
            "ViewerProtocolPolicy": "allow-all",
            "MinTTL": 86400,
            "DefaultTTL": 86400,
            "MaxTTL": 86400,
            "ForwardedValues": {
              "QueryString": false
            }
          },
          "Origins": [
            {
              "Id": "origin1",
              "DomainName": "example.com",
              "CustomOriginConfig": {
                "OriginProtocolPolicy": "https-only"
              }
            }
          ]
        }
      }
    }
  }
}
