{
  "Resources": {
    "CS": {
      "Type": "AWS::SES::ConfigurationSet"
    },
    "ED": {
      "Type": "AWS::SES::ConfigurationSetEventDestination",
      "Properties": {
        "ConfigurationSetName": {
          "Ref": "CS"
        },
        "EventDestination": {
          "Enabled": true,
          "MatchingEventTypes": [
            "SEND",
            "BOGUS_EVENT"
          ],
          "SnsDestination": {
            "TopicARN": {
              "Ref": "T"
            }
          }
        }
      }
    },
    "T": {
      "Type": "AWS::SNS::Topic"
    }
  }
}
