{
  "Resources": {
    "CS": {
      "Type": "AWS::SES::ConfigurationSet"
    },
    "ED": {
      "Type": "AWS::SES::ConfigurationSetEventDestination",
      "Properties": {
        "ConfigurationSetName": {
          "Ref": "CS"
        },
        "EventDestination": {
          "Enabled": true,
          "MatchingEventTypes": [
            "SEND"
          ],
          "SnsDestination": {
            "TopicARN": {
              "Fn::Sub": "arn:${AWS::Partition}:sns:eu-west-1:${AWS::AccountId}:cdkpf-ses70-elsewhere"
            }
          }
        }
      }
    }
  }
}
