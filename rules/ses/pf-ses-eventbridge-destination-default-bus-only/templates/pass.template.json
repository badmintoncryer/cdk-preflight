{
  "Resources": {
    "CS": {
      "Type": "AWS::SES::ConfigurationSet"
    },
    "ED": {
      "Type": "AWS::SES::ConfigurationSetEventDestination",
      "Properties": {
        "ConfigurationSetName": {
          "Ref": "CS"
        },
        "EventDestination": {
          "Enabled": true,
          "MatchingEventTypes": [
            "SEND"
          ],
          "EventBridgeDestination": {
            "EventBusArn": {
              "Fn::Sub": "arn:${AWS::Partition}:events:${AWS::Region}:${AWS::AccountId}:event-bus/default"
            }
          }
        }
      }
    }
  }
}
