{
  "Resources": {
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "bedrock.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "bedrock",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock:*"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "Flow": {
      "Type": "AWS::Bedrock::Flow",
      "Properties": {
        "Name": "cdkpf-fdsj-fail",
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "Role",
            "Arn"
          ]
        },
        "DefinitionString": "not json {"
      }
    }
  }
}