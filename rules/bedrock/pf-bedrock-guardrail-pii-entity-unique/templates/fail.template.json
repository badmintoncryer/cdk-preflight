{
  "Resources": {
    "Guardrail": {
      "Type": "AWS::Bedrock::Guardrail",
      "Properties": {
        "Name": "cdkpf-gpiu-fail",
        "BlockedInputMessaging": "blocked",
        "BlockedOutputsMessaging": "blocked",
        "ContentPolicyConfig": {
          "FiltersConfig": [
            {
              "Type": "HATE",
              "InputStrength": "HIGH",
              "OutputStrength": "HIGH"
            }
          ]
        },
        "SensitiveInformationPolicyConfig": {
          "PiiEntitiesConfig": [
            {
              "Type": "EMAIL",
              "Action": "BLOCK"
            },
            {
              "Type": "EMAIL",
              "Action": "ANONYMIZE"
            }
          ]
        }
      }
    }
  }
}