{
  "Resources": {
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "events.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    },
    "R1": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "EventPattern": {
          "source": [
            "cdkpf.test"
          ]
        },
        "State": "DISABLED",
        "Targets": [
          {
            "Id": "t1",
            "RoleArn": {
              "Fn::GetAtt": [
                "Role",
                "Arn"
              ]
            },
            "Arn": "arn:aws:ecs:us-east-1:214794239830:cluster/C",
            "EcsParameters": {
              "TaskDefinitionArn": "arn:aws:ecs:us-east-1:214794239830:task-definition/T:1",
              "LaunchType": "FARGATE",
              "TaskCount": 10,
              "NetworkConfiguration": {
                "AwsVpcConfiguration": {
                  "Subnets": [
                    "subnet-0000000000000000",
                    "subnet-0000000000000001",
                    "subnet-0000000000000002",
                    "subnet-0000000000000003",
                    "subnet-0000000000000004",
                    "subnet-0000000000000005",
                    "subnet-0000000000000006",
                    "subnet-0000000000000007",
                    "subnet-0000000000000008",
                    "subnet-0000000000000009",
                    "subnet-000000000000000a",
                    "subnet-000000000000000b",
                    "subnet-000000000000000c",
                    "subnet-000000000000000d",
                    "subnet-000000000000000e",
                    "subnet-000000000000000f"
                  ],
                  "SecurityGroups": [
                    "sg-0000000000000000",
                    "sg-0000000000000001",
                    "sg-0000000000000002",
                    "sg-0000000000000003",
                    "sg-0000000000000004"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
}
