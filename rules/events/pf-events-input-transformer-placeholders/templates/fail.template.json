{
  "Resources": {
    "Q": {
      "Type": "AWS::SQS::Queue",
      "Properties": {}
    },
    "R": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "EventPattern": {
          "source": [
            "aws.ec2"
          ]
        },
        "Targets": [
          {
            "Id": "t1",
            "Arn": {
              "Fn::GetAtt": [
                "Q",
                "Arn"
              ]
            },
            "InputTransformer": {
              "InputPathsMap": {
                "detailType": "$.detail-type"
              },
              "InputTemplate": "\"got <detailType> from <undeclared>\""
            }
          }
        ]
      }
    }
  }
}
