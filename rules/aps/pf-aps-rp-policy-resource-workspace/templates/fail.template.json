{
  "Resources": {
    "CdkpfApsWs": {
      "Type": "AWS::APS::Workspace",
      "Properties": {
        "Alias": "cdkpf-rp-policy-resource-workspace"
      }
    },
    "CdkpfApsRp": {
      "Type": "AWS::APS::ResourcePolicy",
      "Properties": {
        "WorkspaceArn": {
          "Fn::GetAtt": [
            "CdkpfApsWs",
            "Arn"
          ]
        },
        "PolicyDocument": {
          "Fn::Sub": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"AWS\":\"arn:aws:iam::${AWS::AccountId}:root\"},\"Action\":[\"aps:RemoteWrite\"],\"Resource\":\"arn:aws:aps:us-east-1:${AWS::AccountId}:workspace/ws-11111111-1111-1111-1111-111111111111\"}]}"
        }
      }
    }
  }
}
