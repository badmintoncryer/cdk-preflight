{
  "Resources": {
    "CdkpfApsWs": {
      "Type": "AWS::APS::Workspace",
      "Properties": {
        "Alias": "cdkpf-rp-policy-principal-required"
      }
    },
    "CdkpfApsRp": {
      "Type": "AWS::APS::ResourcePolicy",
      "Properties": {
        "WorkspaceArn": {
          "Fn::GetAtt": [
            "CdkpfApsWs",
            "Arn"
          ]
        },
        "PolicyDocument": {
          "Fn::Sub": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"AWS\":\"arn:aws:iam::${AWS::AccountId}:root\"},\"Action\":[\"aps:RemoteWrite\"]}]}"
        }
      }
    }
  }
}
