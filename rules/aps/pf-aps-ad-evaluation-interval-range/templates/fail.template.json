{
  "Resources": {
    "CdkpfApsWs": {
      "Type": "AWS::APS::Workspace",
      "Properties": {
        "Alias": "cdkpf-ad-eval"
      }
    },
    "CdkpfApsAd": {
      "Type": "AWS::APS::AnomalyDetector",
      "Properties": {
        "Workspace": {
          "Fn::GetAtt": [
            "CdkpfApsWs",
            "Arn"
          ]
        },
        "Alias": "cdkpf-ad-eval-lo",
        "Configuration": {
          "RandomCutForest": {
            "Query": "avg(up)"
          }
        },
        "EvaluationIntervalInSeconds": 29
      }
    },
    "CdkpfApsAd2": {
      "Type": "AWS::APS::AnomalyDetector",
      "Properties": {
        "Workspace": {
          "Fn::GetAtt": [
            "CdkpfApsWs",
            "Arn"
          ]
        },
        "Alias": "cdkpf-ad-eval-hi",
        "Configuration": {
          "RandomCutForest": {
            "Query": "avg(up)"
          }
        },
        "EvaluationIntervalInSeconds": 86401
      }
    }
  }
}
