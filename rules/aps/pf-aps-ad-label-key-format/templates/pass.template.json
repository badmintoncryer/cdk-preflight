{
  "Resources": {
    "CdkpfApsWs": {
      "Type": "AWS::APS::Workspace",
      "Properties": {
        "Alias": "cdkpf-ad-label-key"
      }
    },
    "CdkpfApsAd": {
      "Type": "AWS::APS::AnomalyDetector",
      "Properties": {
        "Workspace": {
          "Fn::GetAtt": [
            "CdkpfApsWs",
            "Arn"
          ]
        },
        "Alias": "cdkpf-ad-label-key",
        "Configuration": {
          "RandomCutForest": {
            "Query": "avg(up)"
          }
        },
        "Labels": [
          {
            "Key": "team_name",
            "Value": "infra"
          },
          {
            "Key": "_name",
            "Value": "infra"
          }
        ]
      }
    }
  }
}
