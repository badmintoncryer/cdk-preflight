{
  "Resources": {
    "CdkpfApsWs": {
      "Type": "AWS::APS::Workspace",
      "Properties": {
        "Alias": "cdkpf-rgn-name-ascii-alnum"
      }
    },
    "CdkpfApsRgn": {
      "Type": "AWS::APS::RuleGroupsNamespace",
      "Properties": {
        "Workspace": {
          "Fn::GetAtt": [
            "CdkpfApsWs",
            "Arn"
          ]
        },
        "Name": "---",
        "Data": "groups:\n  - name: g1\n    interval: 60s\n    rules:\n      - record: job:up:avg\n        expr: avg(up)\n"
      }
    }
  }
}
