{
  "Resources": {
    "CdkpfApsWs": {
      "Type": "AWS::APS::Workspace",
      "Properties": {
        "Alias": "cdkpf-rgn-data-recording-rule-alert-fields"
      }
    },
    "CdkpfApsRgn": {
      "Type": "AWS::APS::RuleGroupsNamespace",
      "Properties": {
        "Workspace": {
          "Fn::GetAtt": [
            "CdkpfApsWs",
            "Arn"
          ]
        },
        "Name": "cdkpf-rgn-data-recording-rule-alert-fields",
        "Data": "groups:\n  - name: g1\n    rules:\n      - record: job:up:avg\n        expr: avg(up)\n        for: 5m\n"
      }
    }
  }
}
