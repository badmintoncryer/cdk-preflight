{
  "Resources": {
    "CdkpfApsWs": {
      "Type": "AWS::APS::Workspace",
      "Properties": {
        "Alias": "cdkpf-ws-log-group-arn-region",
        "LoggingConfiguration": {
          "LogGroupArn": {
            "Fn::Sub": "arn:aws:logs:us-east-1:${AWS::AccountId}:log-group:/aws/vendedlogs/cdkpf:*"
          }
        }
      }
    },
    "CdkpfApsWsQl": {
      "Type": "AWS::APS::Workspace",
      "Properties": {
        "Alias": "cdkpf-ql-region",
        "QueryLoggingConfiguration": {
          "Destinations": [
            {
              "CloudWatchLogs": {
                "LogGroupArn": {
                  "Fn::Sub": "arn:aws:logs:us-east-1:${AWS::AccountId}:log-group:/aws/vendedlogs/cdkpf:*"
                }
              },
              "Filters": {
                "QspThreshold": 1000
              }
            }
          ]
        }
      }
    }
  }
}
