{
  "Resources": {
    "CdkpfApsWs": {
      "Type": "AWS::APS::Workspace",
      "Properties": {
        "Alias": "cdkpf-ws-log-group-arn-format",
        "LoggingConfiguration": {
          "LogGroupArn": "arn:aws:logs:us-east-1:214794239830:log-group:/aws/vendedlogs/cdkpf:*"
        }
      }
    },
    "CdkpfApsWsQl": {
      "Type": "AWS::APS::Workspace",
      "Properties": {
        "Alias": "cdkpf-ql-format",
        "QueryLoggingConfiguration": {
          "Destinations": [
            {
              "CloudWatchLogs": {
                "LogGroupArn": "arn:aws:logs:us-east-1:214794239830:log-group:/aws/vendedlogs/cdkpf:*"
              },
              "Filters": {
                "QspThreshold": 1000
              }
            }
          ]
        }
      }
    }
  }
}
