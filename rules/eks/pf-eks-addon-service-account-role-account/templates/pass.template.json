{
  "Resources": {
    "SaRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "pods.eks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    },
    "Main": {
      "Type": "AWS::EKS::Addon",
      "Properties": {
        "ClusterName": "cdkpf-eks-absent-sarole",
        "AddonName": "vpc-cni",
        "ServiceAccountRoleArn": {
          "Fn::GetAtt": [
            "SaRole",
            "Arn"
          ]
        }
      }
    }
  }
}
