{
  "Resources": {
    "PodRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "pods.eks.amazonaws.com"
              },
              "Action": [
                "sts:AssumeRole",
                "sts:TagSession"
              ]
            }
          ]
        }
      }
    },
    "Main": {
      "Type": "AWS::EKS::PodIdentityAssociation",
      "Properties": {
        "ClusterName": "cdkpf-eks-absent-pirole",
        "Namespace": "cdkpf-ns",
        "ServiceAccount": "cdkpf-sa",
        "RoleArn": "arn:aws:iam::999999999999:role/cdkpf-foreign"
      }
    }
  }
}
