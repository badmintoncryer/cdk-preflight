{
  "Resources": {
    "NodeRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    },
    "Main": {
      "Type": "AWS::EKS::AccessEntry",
      "Properties": {
        "ClusterName": "cdkpf-eks-absent-aeacct",
        "PrincipalArn": "arn:aws:iam::999999999999:role/cdkpf-foreign",
        "Type": "EC2_LINUX"
      }
    }
  }
}
