{
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.0.0.0/16"
      }
    },
    "SubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.0.0.0/24",
        "AvailabilityZoneId": "use1-az2"
      }
    },
    "SubnetB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.0.1.0/24",
        "AvailabilityZoneId": "use1-az4"
      }
    },
    "ClusterRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "eks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonEKSClusterPolicy"
        ]
      }
    },
    "Cluster": {
      "Type": "AWS::EKS::Cluster",
      "Properties": {
        "RoleArn": {
          "Fn::GetAtt": [
            "ClusterRole",
            "Arn"
          ]
        },
        "ResourcesVpcConfig": {
          "SubnetIds": [
            {
              "Ref": "SubnetA"
            },
            {
              "Ref": "SubnetB"
            }
          ]
        }
      }
    },
    "PodRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "eks-fargate-pods.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonEKSFargatePodExecutionRolePolicy"
        ]
      }
    },
    "Main": {
      "Type": "AWS::EKS::FargateProfile",
      "Properties": {
        "ClusterName": {
          "Ref": "Cluster"
        },
        "FargateProfileName": "cdkpf-fp",
        "PodExecutionRoleArn": {
          "Fn::GetAtt": [
            "PodRole",
            "Arn"
          ]
        },
        "Subnets": [
          {
            "Ref": "SubnetA"
          }
        ],
        "Selectors": [
          {
            "Namespace": "ns0"
          },
          {
            "Namespace": "ns1"
          },
          {
            "Namespace": "ns2"
          },
          {
            "Namespace": "ns3"
          },
          {
            "Namespace": "ns4"
          },
          {
            "Namespace": "ns5"
          }
        ]
      }
    }
  }
}
