{
  "Resources": {
    "App": {
      "Type": "AWS::ElasticBeanstalk::Application",
      "Properties": {}
    },
    "V1": {
      "Type": "AWS::ElasticBeanstalk::ApplicationVersion",
      "Properties": {
        "ApplicationName": {
          "Ref": "App"
        },
        "SourceBundle": {
          "S3Bucket": {
            "Fn::Sub": "cdkpf-fixtures-${AWS::AccountId}"
          },
          "S3Key": "eb/app.zip"
        },
        "ImageConfiguration": {
          "Source": {
            "Uri": {
              "Fn::Sub": "${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/cdkpf-eb:1"
            }
          }
        }
      }
    }
  }
}
