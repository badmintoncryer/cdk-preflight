        },
        "ImageConfiguration": {
          "Build": {
            "Type": "docker",
            "CodeBuildServiceRole": {
              "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/cdkpf-eb-codebuild"
            }
          }
        }
      }
    }
  }
