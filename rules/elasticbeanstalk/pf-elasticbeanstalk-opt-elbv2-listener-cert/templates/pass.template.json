{
  "Resources": {
    "App": {
      "Type": "AWS::ElasticBeanstalk::Application",
      "Properties": {}
    },
    "T1": {
      "Type": "AWS::ElasticBeanstalk::ConfigurationTemplate",
      "Properties": {
        "ApplicationName": {
          "Ref": "App"
        },
        "PlatformArn": "arn:aws:elasticbeanstalk:ap-northeast-1::platform/Node.js 22 running on 64bit Amazon Linux 2023/6.11.9",
        "OptionSettings": [
          {
            "Namespace": "aws:elasticbeanstalk:environment",
            "OptionName": "LoadBalancerType",
            "Value": "application"
          },
          {
            "Namespace": "aws:elbv2:listener:443",
            "OptionName": "Protocol",
            "Value": "HTTPS"
          },
          {
            "Namespace": "aws:elbv2:listener:443",
            "OptionName": "SSLCertificateArns",
            "Value": "arn:aws:acm:ap-northeast-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"
          }
        ]
      }
    }
  }
}
