   }
  },
  "Target": {
   "Type": "AWS::AppSync::SourceApiAssociation",
   "Properties": {
    "MergedApiIdentifier": {
     "Fn::GetAtt": [
      "Merged",
      "Arn"
     ]
    },
    "SourceApiIdentifier": {
     "Fn::GetAtt": [
      "Merged",
      "Arn"
     ]
    }
   }
  }
 }
}