{
 "Resources": {
  "Api": {
   "Type": "AWS::AppSync::GraphQLApi",
   "Properties": {
    "Name": "api1",
    "AuthenticationType": "API_KEY"
   }
  },
  "Target": {
   "Type": "AWS::AppSync::DataSource",
   "Properties": {
    "ApiId": {
     "Fn::GetAtt": [
      "Api",
      "ApiId"
     ]
    },
    "Name": "ds1",
    "Type": "HTTP",
    "ServiceRoleArn": "arn:aws:iam::123456789012:role/appsync",
    "HttpConfig": {
     "Endpoint": "https://example.com",
     "AuthorizationConfig": {
      "AuthorizationType": "AWS_LAMBDA"
     }
    }
   }
  }
 }
}