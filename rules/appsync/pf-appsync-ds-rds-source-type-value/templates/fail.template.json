{
 "Resources": {
  "Api": {
   "Type": "AWS::AppSync::GraphQLApi",
   "Properties": {
    "Name": "api1",
    "AuthenticationType": "API_KEY"
   }
  },
  "Target": {
   "Type": "AWS::AppSync::DataSource",
   "Properties": {
    "ApiId": {
     "Fn::GetAtt": [
      "Api",
      "ApiId"
     ]
    },
    "Name": "ds1",
    "Type": "RELATIONAL_DATABASE",
    "ServiceRoleArn": {
     "Fn::GetAtt": [
      "Role",
      "Arn"
     ]
    },
    "RelationalDatabaseConfig": {
     "RelationalDatabaseSourceType": "RDS_MYSQL",
     "RdsHttpEndpointConfig": {
      "AwsRegion": "us-east-1",
      "AwsSecretStoreArn": "arn:aws:secretsmanager:us-east-1:214794239830:secret:s",
      "DbClusterIdentifier": "c"
     }
    }
   },
   "DependsOn": [
    "Role"
   ]
  },
  "Role": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Action": "sts:AssumeRole",
       "Principal": {
        "Service": "appsync.amazonaws.com"
       }
      }
     ]
    }
   }
  }
 }
}