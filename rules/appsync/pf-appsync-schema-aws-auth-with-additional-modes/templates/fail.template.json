    "AdditionalAuthenticationProviders": [
     {
      "AuthenticationType": "AWS_IAM"
     }
    ]
   }
  },
  "Target": {
   "Type": "AWS::AppSync::GraphQLSchema",
   "Properties": {
    "ApiId": {
     "Fn::GetAtt": [
      "Api",
      "ApiId"
     ]
    },
    "Definition": "schema { query: Query }\ntype Query { a: String @aws_auth(cognito_groups: [\"g\"]) }\n"
   }
  }
 }
}