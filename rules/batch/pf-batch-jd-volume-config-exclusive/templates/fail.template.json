{
  "Resources": {
    "Main": {
      "Type": "AWS::Batch::JobDefinition",
      "Properties": {
        "Type": "container",
        "ContainerProperties": {
          "Image": "public.ecr.aws/amazonlinux/amazonlinux:2",
          "ResourceRequirements": [
            {
              "Type": "VCPU",
              "Value": "1"
            },
            {
              "Type": "MEMORY",
              "Value": "2048"
            }
          ],
          "Volumes": [
            {
              "Name": "scratch",
              "Host": {
                "SourcePath": "/var/tmp"
              },
              "EfsVolumeConfiguration": {
                "FileSystemId": "fs-0123456789abcdef0"
              }
            }
          ]
        }
      }
    }
  }
}