{
  "Resources": {
    "J": {
      "Type": "AWS::Batch::JobDefinition",
      "Properties": {
        "Type": "multinode",
        "PlatformCapabilities": [
          "EC2"
        ],
        "NodeProperties": {
          "MainNode": 0,
          "NumNodes": 2,
          "NodeRangeProperties": [
            {
              "TargetNodes": "0:",
              "Container": {
                "Image": "public.ecr.aws/amazonlinux/amazonlinux:latest",
                "Vcpus": 1,
                "Memory": 2048
              }
            }
          ]
        }
      }
    }
  }
}
