{
  "Resources": {
    "Main": {
      "Type": "AWS::Batch::ComputeEnvironment",
      "Properties": {
        "Type": "UNMANAGED",
        "ServiceRole": "arn:aws:iam::214794239830:role/aws-service-role/batch.amazonaws.com/AWSServiceRoleForBatch"
      },
      "DependsOn": [
        "BatchRole"
      ]
    },
    "BatchRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "batch.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSBatchServiceRole"
        ]
      }
    }
  }
}