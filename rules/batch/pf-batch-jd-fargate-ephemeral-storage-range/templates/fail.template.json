{
  "Resources": {
    "Main": {
      "Type": "AWS::Batch::JobDefinition",
      "Properties": {
        "Type": "container",
        "PlatformCapabilities": [
          "FARGATE"
        ],
        "ContainerProperties": {
          "Image": "public.ecr.aws/amazonlinux/amazonlinux:2",
          "ExecutionRoleArn": "arn:aws:iam::123456789012:role/ecsTaskExecutionRole",
          "ResourceRequirements": [
            {
              "Type": "VCPU",
              "Value": "0.25"
            },
            {
              "Type": "MEMORY",
              "Value": "512"
            }
          ],
          "EphemeralStorage": {
            "SizeInGiB": 10
          }
        }
      }
    }
  }
}