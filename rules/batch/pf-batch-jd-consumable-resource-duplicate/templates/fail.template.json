{
  "Resources": {
    "Main": {
      "Type": "AWS::Batch::JobDefinition",
      "Properties": {
        "Type": "container",
        "ContainerProperties": {
          "Image": "public.ecr.aws/amazonlinux/amazonlinux:2",
          "ResourceRequirements": [
            {
              "Type": "VCPU",
              "Value": "1"
            },
            {
              "Type": "MEMORY",
              "Value": "2048"
            }
          ]
        },
        "ConsumableResourceProperties": {
          "ConsumableResourceList": [
            {
              "ConsumableResource": "arn:aws:batch:us-east-1:123456789012:consumable-resource/a",
              "Quantity": 1
            },
            {
              "ConsumableResource": "arn:aws:batch:us-east-1:123456789012:consumable-resource/a",
              "Quantity": 2
            }
          ]
        }
      }
    }
  }
}