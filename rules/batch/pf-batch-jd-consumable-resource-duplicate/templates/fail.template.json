{
  "Resources": {
    "Main": {
      "Type": "AWS::Batch::JobDefinition",
      "Properties": {
        "Type": "container",
        "ContainerProperties": {
          "Image": "public.ecr.aws/amazonlinux/amazonlinux:2",
          "ResourceRequirements": [
            {
              "Type": "VCPU",
              "Value": "1"
            },
            {
              "Type": "MEMORY",
              "Value": "2048"
            }
          ]
        },
        "ConsumableResourceProperties": {
          "ConsumableResourceList": [
            {
              "ConsumableResource": {
                "Fn::GetAtt": [
                  "CrDup",
                  "ConsumableResourceArn"
                ]
              },
              "Quantity": 1
            },
            {
              "ConsumableResource": {
                "Fn::GetAtt": [
                  "CrDup",
                  "ConsumableResourceArn"
                ]
              },
              "Quantity": 2
            }
          ]
        }
      },
      "DependsOn": [
        "CrDup"
      ]
    },
    "CrDup": {
      "Type": "AWS::Batch::ConsumableResource",
      "Properties": {
        "ConsumableResourceName": "pf-crdup-a",
        "ResourceType": "REPLENISHABLE",
        "TotalQuantity": 10
      }
    }
  }
}