{
  "Resources": {
    "Main": {
      "Type": "AWS::Batch::JobDefinition",
      "Properties": {
        "Type": "multinode",
        "EksProperties": {
          "PodProperties": {
            "Containers": [
              {
                "Name": "main",
                "Image": "public.ecr.aws/amazonlinux/amazonlinux:2",
                "Resources": {
                  "Limits": {
                    "cpu": "1",
                    "memory": "2048Mi"
                  }
                }
              }
            ]
          }
        },
        "NodeProperties": {
          "MainNode": 0,
          "NumNodes": 2,
          "NodeRangeProperties": [
            {
              "TargetNodes": "0:1",
              "EksProperties": {
                "PodProperties": {
                  "Containers": [
                    {
                      "Name": "main",
                      "Image": "public.ecr.aws/amazonlinux/amazonlinux:2",
                      "Resources": {
                        "Limits": {
                          "cpu": "1",
                          "memory": "2048Mi"
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    }
  }
}