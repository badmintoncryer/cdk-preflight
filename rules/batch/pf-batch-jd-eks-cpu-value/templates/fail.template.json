{
  "Resources": {
    "Main": {
      "Type": "AWS::Batch::JobDefinition",
      "Properties": {
        "Type": "container",
        "EksProperties": {
          "PodProperties": {
            "Containers": [
              {
                "Name": "main",
                "Image": "public.ecr.aws/amazonlinux/amazonlinux:2",
                "Resources": {
                  "Limits": {
                    "cpu": "0.3",
                    "memory": "2048Mi"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}