{
  "Resources": {
    "J": {
      "Type": "AWS::Batch::JobDefinition",
      "Properties": {
        "Type": "container",
        "ContainerProperties": {
          "Image": "public.ecr.aws/amazonlinux/amazonlinux:latest",
          "ResourceRequirements": [
            {
              "Type": "VCPU",
              "Value": "0.25"
            },
            {
              "Type": "MEMORY",
              "Value": "8192"
            }
          ],
          "ExecutionRoleArn": "arn:aws:iam::123456789012:role/ecsTaskExecutionRole"
        },
        "PlatformCapabilities": [
          "FARGATE"
        ]
      }
    }
  }
}
