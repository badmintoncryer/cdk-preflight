{
  "Resources": {
    "Main": {
      "Type": "AWS::Batch::JobDefinition",
      "Properties": {
        "Type": "container",
        "PlatformCapabilities": [
          "FARGATE"
        ],
        "ContainerProperties": {
          "Image": "public.ecr.aws/amazonlinux/amazonlinux:2",
          "ExecutionRoleArn": {
            "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/cdkpf-ecs-probe"
          },
          "ResourceRequirements": [
            {
              "Type": "VCPU",
              "Value": "0.25"
            },
            {
              "Type": "MEMORY",
              "Value": "512"
            }
          ],
          "Privileged": true
        }
      }
    }
  }
}