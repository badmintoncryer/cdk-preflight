{
  "Resources": {
    "P": {
      "Type": "AWS::IoT::Policy",
      "Properties": {
        "PolicyName": "cdkpf270-polstmt-p",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "iot:Connect",
              "Resource": "*"
            },
            {
              "Effect": "Deny",
              "Action": "iot:Publish",
              "Resource": "*"
            }
          ]
        }
      }
    }
  }
}
