{
  "Resources": {
    "IotRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "iot.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    },
    "Q": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": "cdkpf270-racct-p"
      }
    },
    "Ok": {
      "Type": "AWS::IoT::TopicRule",
      "Properties": {
        "RuleName": "cdkpf270_racct_p1",
        "TopicRulePayload": {
          "Sql": "SELECT * FROM 'a/b'",
          "Actions": [
            {
              "Republish": {
                "RoleArn": {
                  "Fn::GetAtt": [
                    "IotRole",
                    "Arn"
                  ]
                },
                "Topic": "cdkpf270out/t"
              }
            },
            {
              "Sqs": {
                "QueueUrl": {
                  "Ref": "Q"
                },
                "RoleArn": {
                  "Fn::GetAtt": [
                    "IotRole",
                    "Arn"
                  ]
                },
                "UseBase64": false
              }
            }
          ]
        }
      }
    }
  }
}
