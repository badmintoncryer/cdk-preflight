{
 "Resources": {
  "Vault": {
   "Type": "AWS::Backup::BackupVault",
   "Properties": {
    "BackupVaultName": "cdkpf-selection-role-trust"
   }
  },
  "Role": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Service": "backup.amazonaws.com"
       },
       "Action": "sts:AssumeRole"
      }
     ]
    },
    "Policies": [
     {
      "PolicyName": "cdkpf-backup-select-trust",
      "PolicyDocument": {
       "Version": "2012-10-17",
       "Statement": [
        {
         "Effect": "Allow",
         "Action": "tag:GetResources",
         "Resource": "*"
        }
       ]
      }
     }
    ]
   }
  },
  "Plan": {
   "Type": "AWS::Backup::BackupPlan",
   "Properties": {
    "BackupPlan": {
     "BackupPlanName": "cdkpf-plan-trust",
     "BackupPlanRule": [
      {
       "RuleName": "cdkpf-rule-trust",
       "TargetBackupVault": {
        "Ref": "Vault"
       },
       "ScheduleExpression": "cron(0 0 1 1 ? 2035)"
      }
     ]
    }
   }
  },
  "Selection": {
   "Type": "AWS::Backup::BackupSelection",
   "Properties": {
    "BackupPlanId": {
     "Ref": "Plan"
    },
    "BackupSelection": {
     "SelectionName": "cdkpf-sel-trust",
     "IamRoleArn": {
      "Fn::GetAtt": [
       "Role",
       "Arn"
      ]
     },
     "ListOfTags": [
      {
       "ConditionType": "STRINGEQUALS",
       "ConditionKey": "cdkpf-no-such-key-trust",
       "ConditionValue": "no-such-value-trust"
      }
     ]
    }
   }
  }
 }
}
