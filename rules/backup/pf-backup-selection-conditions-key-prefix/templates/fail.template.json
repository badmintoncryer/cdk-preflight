{
  "Resources": {
    "Vault": {
      "Type": "AWS::Backup::BackupVault",
      "Properties": {
        "BackupVaultName": "cdkpf-selection-conditions-key-prefix"
      }
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "backup.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "cdkpf-backup-select-69",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "tag:GetResources",
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "Plan": {
      "Type": "AWS::Backup::BackupPlan",
      "Properties": {
        "BackupPlan": {
          "BackupPlanName": "cdkpf-plan-69",
          "BackupPlanRule": [
            {
              "RuleName": "cdkpf-rule-69",
              "TargetBackupVault": {
                "Ref": "Vault"
              },
              "ScheduleExpression": "cron(0 0 1 1 ? 2035)"
            }
          ]
        }
      }
    },
    "Selection": {
      "Type": "AWS::Backup::BackupSelection",
      "Properties": {
        "BackupPlanId": {
          "Ref": "Plan"
        },
        "BackupSelection": {
          "SelectionName": "cdkpf-sel-69",
          "IamRoleArn": {
            "Fn::GetAtt": [
              "Role",
              "Arn"
            ]
          },
          "ListOfTags": [
            {
              "ConditionType": "STRINGEQUALS",
              "ConditionKey": "cdkpf-no-such-key-69",
              "ConditionValue": "no-such-value-69"
            }
          ],
          "Conditions": {
            "StringEquals": [
              {
                "ConditionKey": "cdkpf-no-such-key-69",
                "ConditionValue": "no-such-value-69"
              }
            ]
          }
        }
      }
    }
  }
}
