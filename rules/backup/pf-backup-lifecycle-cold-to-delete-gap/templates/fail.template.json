{
  "Resources": {
    "Vault": {
      "Type": "AWS::Backup::BackupVault",
      "Properties": {
        "BackupVaultName": "cdkpf-lifecycle-cold-to-delete-gap"
      }
    },
    "Plan": {
      "Type": "AWS::Backup::BackupPlan",
      "Properties": {
        "BackupPlan": {
          "BackupPlanName": "cdkpf-plan-69",
          "BackupPlanRule": [
            {
              "RuleName": "cdkpf-rule-69",
              "TargetBackupVault": {
                "Ref": "Vault"
              },
              "ScheduleExpression": "cron(0 0 1 1 ? 2035)",
              "Lifecycle": {
                "MoveToColdStorageAfterDays": 30,
                "DeleteAfterDays": 119
              }
            }
          ]
        }
      }
    }
  }
}
