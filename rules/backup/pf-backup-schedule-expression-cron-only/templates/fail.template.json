{
  "Resources": {
    "Vault": {
      "Type": "AWS::Backup::BackupVault",
      "Properties": {
        "BackupVaultName": "cdkpf-schedule-expression-cron-only"
      }
    },
    "Plan": {
      "Type": "AWS::Backup::BackupPlan",
      "Properties": {
        "BackupPlan": {
          "BackupPlanName": "cdkpf-plan-69",
          "BackupPlanRule": [
            {
              "RuleName": "cdkpf-rule-69",
              "TargetBackupVault": {
                "Ref": "Vault"
              },
              "ScheduleExpression": "rate(1 day)"
            }
          ]
        }
      }
    }
  }
}
