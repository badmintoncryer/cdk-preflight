{
  "Resources": {
    "Vault": {
      "Type": "AWS::Backup::BackupVault",
      "Properties": {
        "BackupVaultName": "cdkpf-advanced-setting-resource-type"
      }
    },
    "Plan": {
      "Type": "AWS::Backup::BackupPlan",
      "Properties": {
        "BackupPlan": {
          "BackupPlanName": "cdkpf-plan-69",
          "BackupPlanRule": [
            {
              "RuleName": "cdkpf-rule-69",
              "TargetBackupVault": {
                "Ref": "Vault"
              },
              "ScheduleExpression": "cron(0 0 1 1 ? 2035)"
            }
          ],
          "AdvancedBackupSettings": [
            {
              "ResourceType": "RDS",
              "BackupOptions": {
                "WindowsVSS": "enabled"
              }
            }
          ]
        }
      }
    }
  }
}
