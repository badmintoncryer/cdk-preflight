{
  "Resources": {
    "Vault": {
      "Type": "AWS::Backup::BackupVault",
      "Properties": {
        "BackupVaultName": "cdkpf-copy-destination-vault-arn"
      }
    },
    "Vault2": {
      "Type": "AWS::Backup::BackupVault",
      "Properties": {
        "BackupVaultName": "cdkpf-copy-destination-vault-arn2"
      }
    },
    "Plan": {
