{
  "Resources": {
    "Vault": {
      "Type": "AWS::Backup::BackupVault",
      "Properties": {
        "BackupVaultName": "cdkpf-start-window-minutes-min"
      }
    },
    "Plan": {
      "Type": "AWS::Backup::BackupPlan",
      "Properties": {
        "BackupPlan": {
          "BackupPlanName": "cdkpf-plan-69",
          "BackupPlanRule": [
            {
              "RuleName": "cdkpf-rule-69",
              "TargetBackupVault": {
                "Ref": "Vault"
              },
              "ScheduleExpression": "cron(0 0 1 1 ? 2035)",
              "StartWindowMinutes": 60
            }
          ]
        }
      }
    }
  }
}
