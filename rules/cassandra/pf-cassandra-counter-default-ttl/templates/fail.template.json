{
  "Resources": {
    "Ks": {
      "Type": "AWS::Cassandra::Keyspace",
      "Properties": {
        "KeyspaceName": "cdkpf_counter_default_ttl"
      }
    },
    "T": {
      "Type": "AWS::Cassandra::Table",
      "Properties": {
        "KeyspaceName": {
          "Ref": "Ks"
        },
        "TableName": "tt",
        "PartitionKeyColumns": [
          {
            "ColumnName": "id",
            "ColumnType": "text"
          }
        ],
        "RegularColumns": [
          {
            "ColumnName": "cn",
            "ColumnType": "counter"
          }
        ],
        "DefaultTimeToLive": 1
      }
    }
  }
}
