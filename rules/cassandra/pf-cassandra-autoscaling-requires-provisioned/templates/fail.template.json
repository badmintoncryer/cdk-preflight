{
  "Resources": {
    "Ks": {
      "Type": "AWS::Cassandra::Keyspace",
      "Properties": {
        "KeyspaceName": "cdkpf_autoscaling_requires_provisioned"
      }
    },
    "T": {
      "Type": "AWS::Cassandra::Table",
      "Properties": {
        "KeyspaceName": {
          "Ref": "Ks"
        },
        "TableName": "tt",
        "PartitionKeyColumns": [
          {
            "ColumnName": "id",
            "ColumnType": "text"
          }
        ],
        "AutoScalingSpecifications": {
          "WriteCapacityAutoScaling": {
            "MinimumUnits": 1,
            "MaximumUnits": 1,
            "ScalingPolicy": {
              "TargetTrackingScalingPolicyConfiguration": {
                "TargetValue": 50
              }
            }
          }
        }
      }
    }
  }
}
