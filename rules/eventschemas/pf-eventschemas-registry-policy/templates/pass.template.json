{
 "AWSTemplateFormatVersion": "2010-09-09",
 "Resources": {
  "Reg": {
   "Type": "AWS::EventSchemas::Registry",
   "Properties": {
    "RegistryName": "cdkpf-bench-policy"
   }
  },
  "Pol": {
   "Type": "AWS::EventSchemas::RegistryPolicy",
   "DependsOn": "Reg",
   "Properties": {
    "RegistryName": "cdkpf-bench-policy",
    "Policy": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Sid": "s1",
       "Effect": "Allow",
       "Principal": {
        "AWS": {
         "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:root"
        }
       },
       "Action": "schemas:DescribeSchema",
       "Resource": {
        "Fn::Sub": "arn:aws:schemas:us-east-1:${AWS::AccountId}:schema/cdkpf-bench-policy*"
       }
      }
     ]
    }
   }
  }
 }
}
