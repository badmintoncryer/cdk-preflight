{
  "Resources": {
    "Rule": {
      "Type": "AWS::ECR::PullThroughCacheRule",
      "Properties": {
        "EcrRepositoryPrefix": "cdkpf-pullthroughcachecred",
        "UpstreamRegistry": "docker-hub",
        "UpstreamRegistryUrl": "registry-1.docker.io",
        "CredentialArn": {
          "Ref": "Secret"
        }
      }
    },
    "Secret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": {
          "Fn::Sub": [
            "ecr-pullthroughcache/cdkpf-${Id}",
            {
              "Id": {
                "Fn::Select": [
                  2,
                  {
                    "Fn::Split": [
                      "/",
                      {
                        "Ref": "AWS::StackId"
                      }
                    ]
                  }
                ]
              }
            }
          ]
        },
        "SecretString": "{\"username\":\"cdkpf\",\"accessToken\":\"cdkpf\"}"
      }
    }
  }
}
