{
  "Resources": {
    "D": {
      "Type": "AWS::OpenSearchService::Domain",
      "Properties": {
        "DomainName": "pfos-kmsregion-f",
        "EngineVersion": "OpenSearch_2.19",
        "ClusterConfig": {
          "InstanceType": "t3.small.search",
          "InstanceCount": 1
        },
        "EBSOptions": {
          "EBSEnabled": true,
          "VolumeType": "gp3",
          "VolumeSize": 10,
          "Iops": 3000,
          "Throughput": 125
        },
        "EncryptionAtRestOptions": {
          "Enabled": true,
          "KmsKeyId": {
            "Fn::Sub": "arn:aws:kms:ap-northeast-1:${AWS::AccountId}:key/11111111-2222-3333-4444-555555555555"
          }
        }
      }
    }
  }
}
