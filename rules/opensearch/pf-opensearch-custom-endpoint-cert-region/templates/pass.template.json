{
  "Resources": {
    "D": {
      "Type": "AWS::OpenSearchService::Domain",
      "Properties": {
        "DomainName": "pfos-certregion-p",
        "EngineVersion": "OpenSearch_2.19",
        "ClusterConfig": {
          "InstanceType": "t3.small.search",
          "InstanceCount": 1
        },
        "EBSOptions": {
          "EBSEnabled": true,
          "VolumeType": "gp3",
          "VolumeSize": 10,
          "Iops": 3000,
          "Throughput": 125
        },
        "DomainEndpointOptions": {
          "CustomEndpointEnabled": true,
          "CustomEndpoint": "search.appnao.com",
          "CustomEndpointCertificateArn": "{{resolve:ssm:/cdkpf/fixtures/acm/wildcard-appnao-com}}",
          "EnforceHTTPS": true
        }
      }
    }
  }
}
