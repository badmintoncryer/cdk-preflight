{
  "Resources": {
    "D": {
      "Type": "AWS::OpenSearchService::Domain",
      "Properties": {
        "DomainName": "pfos-certregion-f",
        "EngineVersion": "OpenSearch_2.19",
        "ClusterConfig": {
          "InstanceType": "t3.small.search",
          "InstanceCount": 1
        },
        "EBSOptions": {
          "EBSEnabled": true,
          "VolumeType": "gp3",
          "VolumeSize": 10,
          "Iops": 3000,
          "Throughput": 125
        },
        "DomainEndpointOptions": {
          "CustomEndpointEnabled": true,
          "CustomEndpoint": "search.appnao.com",
          "CustomEndpointCertificateArn": {
            "Fn::Sub": "arn:aws:acm:ap-northeast-1:${AWS::AccountId}:certificate/11111111-2222-3333-4444-555555555555"
          },
          "EnforceHTTPS": true
        }
      }
    }
  }
}
