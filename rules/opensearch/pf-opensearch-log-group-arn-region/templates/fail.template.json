{
  "Resources": {
    "D": {
      "Type": "AWS::OpenSearchService::Domain",
      "Properties": {
        "DomainName": "pfos-logregion-f",
        "EngineVersion": "OpenSearch_2.19",
        "ClusterConfig": {
          "InstanceType": "t3.small.search",
          "InstanceCount": 1
        },
        "EBSOptions": {
          "EBSEnabled": true,
          "VolumeType": "gp3",
          "VolumeSize": 10,
          "Iops": 3000,
          "Throughput": 125
        },
        "LogPublishingOptions": {
          "SEARCH_SLOW_LOGS": {
            "Enabled": true,
            "CloudWatchLogsLogGroupArn": {
              "Fn::Sub": "arn:aws:logs:ap-northeast-1:${AWS::AccountId}:log-group:/aws/opensearch/pfos"
            }
          }
        }
      }
    }
  }
}
