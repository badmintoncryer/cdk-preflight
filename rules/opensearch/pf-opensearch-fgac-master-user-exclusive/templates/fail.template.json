{
  "Resources": {
    "D": {
      "Type": "AWS::OpenSearchService::Domain",
      "Properties": {
        "DomainName": "pfos-fgacexcl-f",
        "EngineVersion": "OpenSearch_2.19",
        "ClusterConfig": {
          "InstanceType": "m6g.large.search",
          "InstanceCount": 1
        },
        "EBSOptions": {
          "EBSEnabled": true,
          "VolumeType": "gp3",
          "VolumeSize": 10,
          "Iops": 3000,
          "Throughput": 125
        },
        "EncryptionAtRestOptions": {
          "Enabled": true
        },
        "NodeToNodeEncryptionOptions": {
          "Enabled": true
        },
        "DomainEndpointOptions": {
          "EnforceHTTPS": true
        },
        "AdvancedSecurityOptions": {
          "Enabled": true,
          "InternalUserDatabaseEnabled": true,
          "MasterUserOptions": {
            "MasterUserName": "pfadmin",
            "MasterUserPassword": "Pf-Probe-1234!",
            "MasterUserARN": {
              "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/cdkpf-probe"
            }
          }
        }
      }
    }
  }
}
