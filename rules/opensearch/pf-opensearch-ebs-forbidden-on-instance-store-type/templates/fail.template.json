{
  "Resources": {
    "D": {
      "Type": "AWS::OpenSearchService::Domain",
      "Properties": {
        "DomainName": "pfos-ebsstore-f",
        "EngineVersion": "OpenSearch_2.19",
        "ClusterConfig": {
          "InstanceType": "i3.large.search",
          "InstanceCount": 1
        },
        "EBSOptions": {
          "EBSEnabled": true,
          "VolumeType": "gp3",
          "VolumeSize": 100,
          "Iops": 3000,
          "Throughput": 125
        }
      }
    }
  }
}
