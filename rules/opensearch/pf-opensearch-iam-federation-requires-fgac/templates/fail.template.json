{
  "Resources": {
    "D": {
      "Type": "AWS::OpenSearchService::Domain",
      "Properties": {
        "DomainName": "pfos-iamfed-f",
        "EngineVersion": "OpenSearch_2.19",
        "ClusterConfig": {
          "InstanceType": "m6g.large.search",
          "InstanceCount": 1
        },
        "EBSOptions": {
          "EBSEnabled": true,
          "VolumeType": "gp3",
          "VolumeSize": 10,
          "Iops": 3000,
          "Throughput": 125
        },
        "AdvancedSecurityOptions": {
          "Enabled": false,
          "IAMFederationOptions": {
            "Enabled": true,
            "SubjectKey": "sub",
            "RolesKey": "roles"
          }
        }
      }
    }
  }
}
