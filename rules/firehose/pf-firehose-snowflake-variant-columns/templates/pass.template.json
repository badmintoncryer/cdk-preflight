{
  "Resources": {
    "B": {
      "Type": "AWS::S3::Bucket",
      "Properties": {}
    },
    "R": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "firehose.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    },
    "DS": {
      "Type": "AWS::KinesisFirehose::DeliveryStream",
      "Properties": {
        "DeliveryStreamType": "DirectPut",
        "SnowflakeDestinationConfiguration": {
          "AccountUrl": "https://cdkpf-probe.snowflakecomputing.com",
          "Database": "db",
          "Schema": "s",
          "Table": "t",
          "RoleARN": {
            "Fn::GetAtt": [
              "R",
              "Arn"
            ]
          },
          "S3Configuration": {
            "RoleARN": {
              "Fn::GetAtt": [
                "R",
                "Arn"
              ]
            },
            "BucketARN": {
              "Fn::GetAtt": [
                "B",
                "Arn"
              ]
            }
          },
          "PrivateKey": "",
          "User": "u",
          "DataLoadingOption": "VARIANT_CONTENT_AND_METADATA_MAPPING",
          "ContentColumnName": "c",
          "MetaDataColumnName": "m"
        }
      }
    }
  }
}
