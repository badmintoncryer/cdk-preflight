violation contains make_diag_full("pf-firehose-custom-time-zone", "ERROR", name,
	sprintf("%s.CustomTimeZone", [path]),
	sprintf("CustomTimeZone '%s' is not supported; the stream create fails with \"Provided custom time zone is not supported. Custom time zones are limited to UTC and non-3-letter IANA time zones.\"", [z]),
	"Use UTC or one of the supported IANA names (Asia/Calcutta, not Asia/Kolkata)",
	"https://docs.aws.amazon.com/firehose/latest/dev/s3-object-name.html") if {
	some [name, path, c] in _pf_fhlib_prefixed
	z := object.get(c, "CustomTimeZone", null)
	_pf_fhlib_lit(z)
	not z in _pf_fhctz_zones
}
