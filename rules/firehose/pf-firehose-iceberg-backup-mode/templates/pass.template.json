{
  "Resources": {
    "B": {
      "Type": "AWS::S3::Bucket",
      "Properties": {}
    },
    "R": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "firehose.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    },
    "DS": {
      "Type": "AWS::KinesisFirehose::DeliveryStream",
      "Properties": {
        "DeliveryStreamType": "DirectPut",
        "IcebergDestinationConfiguration": {
          "RoleARN": {
            "Fn::GetAtt": [
              "R",
              "Arn"
            ]
          },
          "S3Configuration": {
            "RoleARN": {
              "Fn::GetAtt": [
                "R",
                "Arn"
              ]
            },
            "BucketARN": {
              "Fn::GetAtt": [
                "B",
                "Arn"
              ]
            }
          },
          "CatalogConfiguration": {
            "CatalogArn": {
              "Fn::Sub": "arn:aws:glue:${AWS::Region}:${AWS::AccountId}:catalog"
            }
          },
          "DestinationTableConfigurationList": [
            {
              "DestinationTableName": "t",
              "DestinationDatabaseName": "cdkpf_iceberg_backup_mode"
            }
          ],
          "s3BackupMode": "FailedDataOnly"
        }
      },
      "DependsOn": [
        "P",
        "T"
      ]
    },
    "Db": {
      "Type": "AWS::Glue::Database",
      "Properties": {
        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "DatabaseInput": {
          "Name": "cdkpf_iceberg_backup_mode"
        }
      }
    },
    "T": {
      "Type": "AWS::Glue::Table",
      "Properties": {
        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "DatabaseName": {
          "Ref": "Db"
        },
        "TableInput": {
          "Name": "t",
          "TableType": "EXTERNAL_TABLE",
          "StorageDescriptor": {
            "Columns": [
              {
                "Name": "c",
                "Type": "string"
              }
            ],
            "Location": {
              "Fn::Sub": "s3://${B}/t/"
            }
          }
        }
      }
    },
    "P": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "p",
        "Roles": [
          {
            "Ref": "R"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "glue:GetTable",
                "glue:GetDatabase",
                "glue:UpdateTable"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:aws:glue:${AWS::Region}:${AWS::AccountId}:catalog"
                },
                {
                  "Fn::Sub": "arn:aws:glue:${AWS::Region}:${AWS::AccountId}:database/cdkpf_iceberg_backup_mode"
                },
                {
                  "Fn::Sub": "arn:aws:glue:${AWS::Region}:${AWS::AccountId}:table/cdkpf_iceberg_backup_mode/*"
                }
              ]
            },
            {
              "Effect": "Allow",
              "Action": [
                "s3:AbortMultipartUpload",
                "s3:GetBucketLocation",
                "s3:GetObject",
                "s3:ListBucket",
                "s3:ListBucketMultipartUploads",
                "s3:PutObject",
                "s3:DeleteObject"
              ],
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "B",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${B.Arn}/*"
                }
              ]
            }
          ]
        }
      }
    }
  }
}
