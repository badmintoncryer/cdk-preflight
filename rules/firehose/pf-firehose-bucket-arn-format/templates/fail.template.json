{
  "Resources": {
    "B": {
      "Type": "AWS::S3::Bucket",
      "Properties": {}
    },
    "R": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "firehose.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    },
    "DS": {
      "Type": "AWS::KinesisFirehose::DeliveryStream",
      "Properties": {
        "DeliveryStreamType": "DirectPut",
        "ExtendedS3DestinationConfiguration": {
          "RoleARN": {
            "Fn::GetAtt": [
              "R",
              "Arn"
            ]
          },
          "BucketARN": {
            "Fn::Sub": "arn:aws:s3:us-east-1:${AWS::AccountId}:cdkpf-fixtures-${AWS::AccountId}"
          }
        }
      }
    }
  }
}
