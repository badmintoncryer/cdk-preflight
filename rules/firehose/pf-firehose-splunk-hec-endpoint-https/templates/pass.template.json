{
  "Resources": {
    "B": {
      "Type": "AWS::S3::Bucket",
      "Properties": {}
    },
    "R": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "firehose.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    },
    "DS": {
      "Type": "AWS::KinesisFirehose::DeliveryStream",
      "Properties": {
        "DeliveryStreamType": "DirectPut",
        "SplunkDestinationConfiguration": {
          "HECEndpoint": "https://splunk.example.com:8088",
          "HECEndpointType": "Raw",
          "HECToken": "00000000-1111-2222-3333-444444444444",
          "S3Configuration": {
            "RoleARN": {
              "Fn::GetAtt": [
                "R",
                "Arn"
              ]
            },
            "BucketARN": {
              "Fn::GetAtt": [
                "B",
                "Arn"
              ]
            }
          }
        }
      }
    }
  }
}
