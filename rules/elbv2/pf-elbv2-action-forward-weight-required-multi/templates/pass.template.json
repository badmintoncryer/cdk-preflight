{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "LB": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Type": "application",
        "Subnets": [
          "subnet-2e0a500f",
          "subnet-ab11fde7"
        ],
        "SecurityGroups": [
          "sg-7d699f61"
        ]
      }
    },
    "TG": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Protocol": "HTTP",
        "Port": 80,
        "VpcId": "vpc-4331593e",
        "TargetType": "instance"
      }
    },
    "TG2": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Protocol": "HTTP",
        "Port": 8080,
        "VpcId": "vpc-4331593e",
        "TargetType": "instance"
      }
    },
    "Listener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "LB"
        },
        "DefaultActions": [
          {
            "Type": "forward",
            "ForwardConfig": {
              "TargetGroups": [
                {
                  "TargetGroupArn": {
                    "Ref": "TG"
                  },
                  "Weight": 1
                },
                {
                  "TargetGroupArn": {
                    "Ref": "TG2"
                  },
                  "Weight": 1
                }
              ]
            }
          }
        ],
        "Port": 80,
        "Protocol": "HTTP"
      }
    }
  }
}
