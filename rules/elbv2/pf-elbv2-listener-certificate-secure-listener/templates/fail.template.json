{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "LB": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Type": "application",
        "Subnets": [
          "subnet-2e0a500f",
          "subnet-ab11fde7"
        ],
        "SecurityGroups": [
          "sg-7d699f61"
        ]
      }
    },
    "TG": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Protocol": "HTTP",
        "Port": 80,
        "VpcId": "vpc-4331593e",
        "TargetType": "instance"
      }
    },
    "Listener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "LB"
        },
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "TG"
            }
          }
        ],
        "Port": 80,
        "Protocol": "HTTP"
      }
    },
    "Cert": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerCertificate",
      "Properties": {
        "ListenerArn": {
          "Ref": "Listener"
        },
        "Certificates": [
          {
            "CertificateArn": "arn:aws:acm:us-east-1:214794239830:certificate/06f8bd5d-314f-4bb7-a94a-6ca705935aca"
          }
        ]
      }
    }
  }
}
