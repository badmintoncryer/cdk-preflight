{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.0.0.0/16"
      }
    },
    "TGOff": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Port": 80,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "VpcId": {
          "Ref": "Vpc"
        },
        "TargetGroupAttributes": [
          {
            "Key": "slow_start.duration_seconds",
            "Value": "0"
          }
        ]
      }
    },
    "TGMin": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Port": 80,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "VpcId": {
          "Ref": "Vpc"
        },
        "TargetGroupAttributes": [
          {
            "Key": "slow_start.duration_seconds",
            "Value": "30"
          }
        ]
      }
    },
    "TGMax": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Port": 80,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "VpcId": {
          "Ref": "Vpc"
        },
        "TargetGroupAttributes": [
          {
            "Key": "slow_start.duration_seconds",
            "Value": "900"
          }
        ]
      }
    }
  }
}
