{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "TS": {
      "Type": "AWS::ElasticLoadBalancingV2::TrustStore",
      "Properties": {
        "Name": "pf-ts-elbtsr",
        "CaCertificatesBundleS3Bucket": {
          "Fn::Sub": "cdkpf-fixtures-${AWS::AccountId}"
        },
        "CaCertificatesBundleS3Key": "ca.pem"
      }
    },
    "Rev": {
      "Type": "AWS::ElasticLoadBalancingV2::TrustStoreRevocation",
      "Properties": {
        "TrustStoreArn": {
          "Ref": "TS"
        },
        "RevocationContents": [
          {
            "S3Bucket": {
              "Fn::Sub": "cdkpf-fixtures-${AWS::AccountId}"
            },
            "S3Key": "crl.pem"
          }
        ]
      }
    }
  }
}
