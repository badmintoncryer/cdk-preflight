{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.0.0.0/16"
      }
    },
    "TGLong": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Port": 80,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "VpcId": {
          "Ref": "Vpc"
        },
        "Name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      }
    },
    "TGShape": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Port": 80,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "VpcId": {
          "Ref": "Vpc"
        },
        "Name": "-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-"
      },
      "DependsOn": "TGLong"
    }
  }
}
