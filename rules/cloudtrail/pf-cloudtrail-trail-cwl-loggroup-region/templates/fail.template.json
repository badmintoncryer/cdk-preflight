{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "Bucket": {
      "Type": "AWS::S3::Bucket"
    },
    "BucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Bucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AclCheck",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudtrail.amazonaws.com"
              },
              "Action": "s3:GetBucketAcl",
              "Resource": {
                "Fn::GetAtt": [
                  "Bucket",
                  "Arn"
                ]
              }
            },
            {
              "Sid": "Write",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudtrail.amazonaws.com"
              },
              "Action": "s3:PutObject",
              "Resource": {
                "Fn::Sub": "${Bucket.Arn}/AWSLogs/${AWS::AccountId}/*"
              }
            }
          ]
        }
      }
    },
    "Trail": {
      "Type": "AWS::CloudTrail::Trail",
      "Properties": {
        "IsLogging": false,
        "S3BucketName": {
          "Ref": "Bucket"
        },
        "CloudWatchLogsLogGroupArn": {
          "Fn::Sub": "arn:aws:logs:us-west-2:${AWS::AccountId}:log-group:cdkpf-ct69:*"
        },
        "CloudWatchLogsRoleArn": {
          "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/cdkpf-ct69"
        }
      },
      "DependsOn": "BucketPolicy"
    }
  }
}
