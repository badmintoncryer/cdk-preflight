{
  "Resources": {
    "R": {
      "Type": "AWS::NetworkFirewall::RuleGroup",
      "Properties": {
        "RuleGroupName": "cdkpf280-var-p",
        "Type": "STATEFUL",
        "Capacity": 100,
        "RuleGroup": {
          "RulesSource": {
            "RulesString": "pass tcp $MYNET any -> any $WEB_PORTS (msg:\"a\"; sid:1;)\npass tcp $HOME_NET any -> $EXTERNAL_NET any (msg:\"b\"; sid:2;)"
          },
          "RuleVariables": {
            "IPSets": {
              "MYNET": {
                "Definition": [
                  "10.0.0.0/16"
                ]
              }
            },
            "PortSets": {
              "WEB_PORTS": {
                "Definition": [
                  "80",
                  "443"
                ]
              }
            }
          }
        }
      }
    }
  }
}
