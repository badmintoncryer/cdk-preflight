{
  "Resources": {
    "T": {
      "Type": "AWS::NetworkFirewall::TLSInspectionConfiguration",
      "Properties": {
        "TLSInspectionConfigurationName": "cdkpf280-shtls-p",
        "TLSInspectionConfiguration": {
          "ServerCertificateConfigurations": [
            {
              "ServerCertificates": [
                {
                  "ResourceArn": {
                    "Fn::Sub": "arn:aws:acm:${AWS::Region}:${AWS::AccountId}:certificate/e25484f3-9c39-426f-aff1-e39092fd3c11"
                  }
                }
              ],
              "Scopes": [
                {
                  "Sources": [
                    {
                      "AddressDefinition": "10.0.0.0/16"
                    }
                  ],
                  "Destinations": [
                    {
                      "AddressDefinition": "0.0.0.0/0"
                    }
                  ],
                  "SourcePorts": [
                    {
                      "FromPort": 0,
                      "ToPort": 65535
                    }
                  ],
                  "DestinationPorts": [
                    {
                      "FromPort": 443,
                      "ToPort": 443
                    }
                  ],
                  "Protocols": [
                    6
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    "P": {
      "Type": "AWS::NetworkFirewall::FirewallPolicy",
      "Properties": {
        "FirewallPolicyName": "cdkpf280-shtls-p",
        "FirewallPolicy": {
          "StatelessDefaultActions": [
            "aws:forward_to_sfe"
          ],
          "StatelessFragmentDefaultActions": [
            "aws:forward_to_sfe"
          ],
          "EnableTLSSessionHolding": true,
          "TLSInspectionConfigurationArn": {
            "Fn::GetAtt": [
              "T",
              "TLSInspectionConfigurationArn"
            ]
          }
        }
      }
