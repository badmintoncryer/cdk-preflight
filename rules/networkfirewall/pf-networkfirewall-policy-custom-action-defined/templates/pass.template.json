{
  "Resources": {
    "P": {
      "Type": "AWS::NetworkFirewall::FirewallPolicy",
      "Properties": {
        "FirewallPolicyName": "cdkpf280-pcad-p",
        "FirewallPolicy": {
          "StatelessDefaultActions": [
            "aws:forward_to_sfe"
          ],
          "StatelessFragmentDefaultActions": [
            "aws:forward_to_sfe",
            "MyAct"
          ],
          "StatelessCustomActions": [
            {
              "ActionName": "MyAct",
              "ActionDefinition": {
                "PublishMetricAction": {
                  "Dimensions": [
                    {
                      "Value": "v"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    }
  }
}
