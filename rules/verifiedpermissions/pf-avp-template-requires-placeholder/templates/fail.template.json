{
  "Resources": {
    "Store": {
      "Type": "AWS::VerifiedPermissions::PolicyStore",
      "Properties": {
        "ValidationSettings": {
          "Mode": "OFF"
        }
      }
    },
    "Tpl": {
      "Type": "AWS::VerifiedPermissions::PolicyTemplate",
      "Properties": {
        "PolicyStoreId": {
          "Ref": "Store"
        },
        "Statement": "permit(principal, action, resource);"
      }
    }
  }
}
