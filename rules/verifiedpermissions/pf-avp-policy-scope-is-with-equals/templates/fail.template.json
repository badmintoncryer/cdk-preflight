{
  "Resources": {
    "Store": {
      "Type": "AWS::VerifiedPermissions::PolicyStore",
      "Properties": {
        "ValidationSettings": {
          "Mode": "OFF"
        }
      }
    },
    "Pol": {
      "Type": "AWS::VerifiedPermissions::Policy",
      "Properties": {
        "PolicyStoreId": {
          "Ref": "Store"
        },
        "Definition": {
          "Static": {
            "Statement": "permit(principal is MyApp::User == MyApp::User::\"alice\", action, resource);"
          }
        }
      }
    },
    "Tpl": {
      "Type": "AWS::VerifiedPermissions::PolicyTemplate",
      "Properties": {
        "PolicyStoreId": {
          "Ref": "Store"
        },
        "Statement": "permit(principal is MyApp::User == ?principal, action, resource);"
      }
    }
  }
}
