{
  "Resources": {
    "Store": {
      "Type": "AWS::VerifiedPermissions::PolicyStore",
      "Properties": {
        "ValidationSettings": {
          "Mode": "OFF"
        }
      }
    },
    "Alias": {
      "Type": "AWS::VerifiedPermissions::PolicyStoreAlias",
      "Properties": {
        "PolicyStoreId": {
          "Ref": "Store"
        },
        "AliasName": "my-alias"
      }
    }
  }
}
