{
  "Resources": {
    "Rule": {
      "Type": "AWS::XRay::SamplingRule",
      "Properties": {
        "SamplingRule": {
          "RuleName": "pfxr-namearn-f",
          "Priority": 9001,
          "FixedRate": 0.05,
          "ReservoirSize": 1,
          "Host": "*",
          "HTTPMethod": "*",
          "URLPath": "*",
          "ServiceName": "*",
          "ServiceType": "*",
          "ResourceARN": "*",
          "Version": 1,
          "RuleARN": "arn:aws:xray:us-east-1:123456789012:sampling-rule/pfxr-namearn-f"
        }
      }
    }
  }
}
