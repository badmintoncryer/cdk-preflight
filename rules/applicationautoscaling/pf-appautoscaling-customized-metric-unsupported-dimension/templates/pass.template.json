{
  "Resources": {
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterName": "cdkpf-aas-cmu-p"
      }
    },
    "Task": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "cdkpf-aas-cmu-p",
        "ContainerDefinitions": [
          {
            "Name": "app",
            "Image": "busybox",
            "Memory": 128,
            "Essential": true
          }
        ]
      }
    },
    "Svc": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "ServiceName": "cdkpf-aas-cmu-p-svc",
        "Cluster": {
          "Ref": "Cluster"
        },
        "TaskDefinition": {
          "Ref": "Task"
        },
        "DesiredCount": 0,
        "LaunchType": "EC2"
      }
    },
    "Target": {
      "Type": "AWS::ApplicationAutoScaling::ScalableTarget",
      "Properties": {
        "MaxCapacity": 1,
        "MinCapacity": 0,
        "ResourceId": "service/cdkpf-aas-cmu-p/cdkpf-aas-cmu-p-svc",
        "ScalableDimension": "ecs:service:DesiredCount",
        "ServiceNamespace": "ecs"
      },
      "DependsOn": "Svc"
    },
    "Policy1": {
      "Type": "AWS::ApplicationAutoScaling::ScalingPolicy",
      "Properties": {
        "PolicyType": "TargetTrackingScaling",
        "TargetTrackingScalingPolicyConfiguration": {
          "TargetValue": 50,
          "CustomizedMetricSpecification": {
            "MetricName": "CPUUtilization",
            "Namespace": "AWS/ECS",
            "Statistic": "Average"
          }
        },
        "PolicyName": "cdkpf-aas-cmu-p-1",
        "ScalingTargetId": {
          "Ref": "Target"
        }
      }
    }
  }
}
