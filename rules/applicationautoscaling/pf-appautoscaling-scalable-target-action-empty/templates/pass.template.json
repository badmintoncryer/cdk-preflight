{
  "Resources": {
    "Table": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "TableName": "cdkpf-aas-ste-p",
        "BillingMode": "PROVISIONED",
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          }
        ],
        "ProvisionedThroughput": {
          "ReadCapacityUnits": 1,
          "WriteCapacityUnits": 1
        }
      }
    },
    "Target": {
      "Type": "AWS::ApplicationAutoScaling::ScalableTarget",
      "Properties": {
        "MaxCapacity": 5,
        "MinCapacity": 1,
        "ResourceId": "table/cdkpf-aas-ste-p",
        "ScalableDimension": "dynamodb:table:ReadCapacityUnits",
        "ServiceNamespace": "dynamodb",
        "ScheduledActions": [
          {
            "ScheduledActionName": "cdkpf-ste-one",
            "Schedule": "cron(0 8 1 * ? *)",
            "ScalableTargetAction": {
              "MinCapacity": 1
            },
            "StartTime": "2035-01-01T00:00:00Z"
          },
          {
            "ScheduledActionName": "cdkpf-ste-two",
            "Schedule": "cron(0 9 1 * ? *)",
            "ScalableTargetAction": {
              "MaxCapacity": 2
            },
            "StartTime": "2035-01-01T00:00:00Z"
          }
        ]
      },
      "DependsOn": "Table"
    }
  }
}
