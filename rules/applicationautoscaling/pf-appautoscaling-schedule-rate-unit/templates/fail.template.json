{
  "Resources": {
    "Table": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "TableName": "cdkpf-aas-sru-f",
        "BillingMode": "PROVISIONED",
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          }
        ],
        "ProvisionedThroughput": {
          "ReadCapacityUnits": 1,
          "WriteCapacityUnits": 1
        }
      }
    },
    "Target": {
      "Type": "AWS::ApplicationAutoScaling::ScalableTarget",
      "Properties": {
        "MaxCapacity": 5,
        "MinCapacity": 1,
        "ResourceId": "table/cdkpf-aas-sru-f",
        "ScalableDimension": "dynamodb:table:ReadCapacityUnits",
        "ServiceNamespace": "dynamodb",
        "ScheduledActions": [
          {
            "ScheduledActionName": "cdkpf-sru-one",
            "Schedule": "rate(5 seconds)",
            "ScalableTargetAction": {
              "MinCapacity": 1,
              "MaxCapacity": 1
            }
          },
          {
            "ScheduledActionName": "cdkpf-sru-two",
            "Schedule": "rate(0 minutes)",
            "ScalableTargetAction": {
              "MinCapacity": 1,
              "MaxCapacity": 1
            }
          }
        ]
      },
      "DependsOn": "Table"
    }
  }
}
