{
  "Resources": {
    "P": {
      "Type": "AWS::Cognito::IdentityPool",
      "Properties": {
        "AllowUnauthenticatedIdentities": false,
        "IdentityPoolName": "pfprobe"
      }
    },
    "X": {
      "Type": "AWS::Cognito::IdentityPoolRoleAttachment",
      "Properties": {
        "IdentityPoolId": {
          "Ref": "P"
        },
        "Roles": {
          "admin": {
            "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/pfprobe"
          }
        }
      }
    }
  }
}
