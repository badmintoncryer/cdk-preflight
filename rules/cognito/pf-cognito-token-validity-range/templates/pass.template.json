{
  "Resources": {
    "UP": {
      "Type": "AWS::Cognito::UserPool",
      "Properties": {
        "UserPoolName": "p"
      }
    },
    "C": {
      "Type": "AWS::Cognito::UserPoolClient",
      "Properties": {
        "UserPoolId": {
          "Ref": "UP"
        },
        "ClientName": "c",
        "TokenValidityUnits": {
          "AccessToken": "hours",
          "IdToken": "hours",
          "RefreshToken": "days"
        },
        "AccessTokenValidity": 12,
        "IdTokenValidity": 12,
        "RefreshTokenValidity": 30
      }
    }
  }
}
