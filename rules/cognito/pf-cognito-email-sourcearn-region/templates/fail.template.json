{
  "Resources": {
    "X": {
      "Type": "AWS::Cognito::UserPool",
      "Properties": {
        "UserPoolName": "pfprobe",
        "EmailConfiguration": {
          "EmailSendingAccount": "DEVELOPER",
          "SourceArn": {
            "Fn::Sub": "arn:aws:ses:ap-northeast-1:${AWS::AccountId}:identity/pf@example.com"
          }
        }
      }
    }
  }
}
