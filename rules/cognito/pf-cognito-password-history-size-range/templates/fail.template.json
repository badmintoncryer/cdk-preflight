{
  "Resources": {
    "X": {
      "Type": "AWS::Cognito::UserPool",
      "Properties": {
        "UserPoolName": "pfprobe",
        "UserPoolTier": "PLUS",
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 8,
            "PasswordHistorySize": 30
          }
        }
      }
    }
  }
}
