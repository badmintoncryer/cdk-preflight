{
  "Resources": {
    "P": {
      "Type": "AWS::Cognito::UserPool",
      "Properties": {
        "UserPoolName": "pfprobe"
      }
    },
    "X": {
      "Type": "AWS::Cognito::UserPoolRiskConfigurationAttachment",
      "Properties": {
        "UserPoolId": {
          "Ref": "P"
        },
        "ClientId": "ALL",
        "AccountTakeoverRiskConfiguration": {
          "NotifyConfiguration": {
            "SourceArn": {
              "Fn::Sub": "arn:aws:ses:ap-northeast-1:${AWS::AccountId}:identity/pf@example.com"
            }
          },
          "Actions": {
            "HighAction": {
              "EventAction": "BLOCK",
              "Notify": true
            }
          }
        }
      }
    }
  }
}
