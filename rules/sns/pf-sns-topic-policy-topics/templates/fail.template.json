{
  "Resources": {
    "T": {
      "Type": "AWS::SNS::Topic",
      "Properties": {}
    },
    "P": {
      "Type": "AWS::SNS::TopicPolicy",
      "Properties": {
        "Topics": [
          {
            "Fn::GetAtt": [
              "T",
              "TopicName"
            ]
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "events.amazonaws.com"
              },
              "Action": "sns:Publish",
              "Resource": {
                "Ref": "T"
              }
            }
          ]
        }
      }
    }
  }
}
