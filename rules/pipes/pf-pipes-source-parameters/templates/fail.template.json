{
 "AWSTemplateFormatVersion": "2010-09-09",
 "Resources": {
  "P1": {
   "Type": "AWS::Pipes::Pipe",
   "Properties": {
    "RoleArn": {
     "Fn::GetAtt": [
      "Role",
      "Arn"
     ]
    },
    "Source": {
     "Fn::Sub": "arn:aws:kinesis:us-east-1:${AWS::AccountId}:stream/S"
    },
    "Target": {
     "Fn::Sub": "arn:aws:lambda:us-east-1:${AWS::AccountId}:function:F"
    }
   }
  },
  "Role": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Service": "pipes.amazonaws.com"
       },
       "Action": "sts:AssumeRole"
      }
     ]
    }
   }
  }
 }
}
