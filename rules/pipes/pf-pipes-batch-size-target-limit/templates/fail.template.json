{
 "AWSTemplateFormatVersion": "2010-09-09",
 "Resources": {
  "P1": {
   "Type": "AWS::Pipes::Pipe",
   "Properties": {
    "RoleArn": {
     "Fn::GetAtt": [
      "Role",
      "Arn"
     ]
    },
    "Source": "arn:aws:kinesis:us-east-1:214794239830:stream/S",
    "Target": "arn:aws:sqs:us-east-1:214794239830:Q2",
    "SourceParameters": {
     "KinesisStreamParameters": {
      "StartingPosition": "LATEST",
      "BatchSize": 11
     }
    },
    "TargetParameters": {
     "SqsQueueParameters": {}
    }
   }
  },
  "Role": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Service": "pipes.amazonaws.com"
       },
       "Action": "sts:AssumeRole"
      }
     ]
    }
   }
  }
 }
}
