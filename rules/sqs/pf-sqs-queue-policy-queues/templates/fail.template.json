{
  "Resources": {
    "Q": {
      "Type": "AWS::SQS::Queue",
      "Properties": {}
    },
    "P": {
      "Type": "AWS::SQS::QueuePolicy",
      "Properties": {
        "Queues": [
          {
            "Fn::GetAtt": [
              "Q",
              "Arn"
            ]
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "sns.amazonaws.com"
              },
              "Action": "sqs:SendMessage",
              "Resource": {
                "Fn::GetAtt": [
                  "Q",
                  "Arn"
                ]
              }
            }
          ]
        }
      }
    }
  }
}
