{
  "Resources": {
    "F": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Role": {
          "Fn::GetAtt": [
            "R",
            "Arn"
          ]
        },
        "Code": {
          "ZipFile": "def handler(e, c):\n    return 0\n"
        },
        "Runtime": "python3.12",
        "Handler": "index.handler",
        "MemorySize": 10240
      }
    },
    "R": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    }
  }
}
