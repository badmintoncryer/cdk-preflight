{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "L": {
      "Type": "AWS::Lambda::LayerVersion",
      "Properties": {
        "LayerName": "cdkpf-layer",
        "Content": {
          "S3Bucket": {
            "Fn::Sub": "cdkpf-fixtures-${AWS::AccountId}"
          },
          "S3Key": "l.zip"
        },
        "CompatibleRuntimes": [
          "python3.12",
          "python3.14",
          "python3.15",
          "nodejs24.x",
          "nodejs26.x",
          "java25",
          "dotnet10",
          "ruby3.4",
          "ruby4.0"
        ]
      }
    }
  }
}
