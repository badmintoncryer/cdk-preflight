{
  "Resources": {
    "R": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "sqs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Q",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Q": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "FifoQueue": true,
        "QueueName": "pf-esm.fifo"
      }
    },
    "F": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Role": {
          "Fn::GetAtt": [
            "R",
            "Arn"
          ]
        },
        "Code": {
          "ZipFile": "def handler(e, c):\n    return 0\n"
        },
        "Runtime": "python3.12",
        "Handler": "index.handler"
      }
    },
    "M": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": {
        "FunctionName": {
          "Ref": "F"
        },
        "EventSourceArn": {
          "Fn::GetAtt": [
            "Q",
            "Arn"
          ]
        }
      }
    }
  }
}
