{
  "Resources": {
    "FnRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    },
    "Fn": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "python3.12",
        "Handler": "index.handler",
        "Role": {
          "Fn::GetAtt": [
            "FnRole",
            "Arn"
          ]
        },
        "Code": {
          "ZipFile": "def handler(event, context):\n    return {}\n"
        },
        "Environment": {
          "Variables": {
            "SMALL_VALUE": "ok"
          }
        }
      }
    }
  }
}
