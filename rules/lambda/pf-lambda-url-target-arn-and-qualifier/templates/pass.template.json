{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "R": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "base",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogGroup",
                    "logs:CreateLogStream",
                    "logs:PutLogEvents",
                    "sqs:SendMessage",
                    "sns:Publish",
                    "s3:PutObject",
                    "events:PutEvents",
                    "lambda:InvokeFunction"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "F": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Role": {
          "Fn::GetAtt": [
            "R",
            "Arn"
          ]
        },
        "Code": {
          "ZipFile": "exports.handler=async()=>{}"
        },
        "Runtime": "nodejs22.x",
        "Handler": "index.handler"
      }
    },
    "U": {
      "Type": "AWS::Lambda::Url",
      "Properties": {
        "TargetFunctionArn": {
          "Fn::GetAtt": [
            "F",
            "Arn"
          ]
        },
        "AuthType": "AWS_IAM",
        "Qualifier": "live"
      },
      "DependsOn": "A"
    },
    "V1": {
      "Type": "AWS::Lambda::Version",
      "Properties": {
        "FunctionName": {
          "Ref": "F"
        }
      }
    },
    "A": {
      "Type": "AWS::Lambda::Alias",
      "Properties": {
        "FunctionName": {
          "Ref": "F"
        },
        "FunctionVersion": {
          "Fn::GetAtt": [
            "V1",
            "Version"
          ]
        },
        "Name": "live"
      }
    }
  }
}
