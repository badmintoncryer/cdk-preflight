{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.0.0.0/16"
      }
    },
    "Igw": {
      "Type": "AWS::EC2::InternetGateway"
    },
    "Att": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "Igw"
        }
      }
    },
    "PubA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.0.0.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        }
      }
    },
    "PubRt": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "PubRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "Att",
      "Properties": {
        "RouteTableId": {
          "Ref": "PubRt"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Igw"
        }
      }
    },
    "PubAssoc": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": {
          "Ref": "PubRt"
        },
        "SubnetId": {
          "Ref": "PubA"
        }
      }
    },
    "Eip": {
      "Type": "AWS::EC2::EIP",
      "DependsOn": "Att",
      "Properties": {
        "Domain": "vpc"
      }
    },
    "Nat": {
      "Type": "AWS::EC2::NatGateway",
      "DependsOn": "PubAssoc",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "Eip",
            "AllocationId"
          ]
        },
        "SubnetId": {
          "Ref": "PubA"
        }
      }
    },
    "PrivA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.0.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        }
      }
    },
    "PrivB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.0.2.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        }
      }
    },
    "PrivRt": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "PrivRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PrivRt"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "Nat"
        }
      }
    },
    "PrivAssocA": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": {
          "Ref": "PrivRt"
        },
        "SubnetId": {
          "Ref": "PrivA"
        }
      }
    },
    "PrivAssocB": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": {
          "Ref": "PrivRt"
        },
        "SubnetId": {
          "Ref": "PrivB"
        }
      }
    },
    "Sg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "cdkpf lmi",
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "OpRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AWSLambdaManagedEC2ResourceOperator"
          }
        ]
      }
    },
    "Cp": {
      "Type": "AWS::Lambda::CapacityProvider",
      "DependsOn": [
        "PrivRoute",
        "PrivAssocA",
        "PrivAssocB"
      ],
      "Properties": {
        "PermissionsConfig": {
          "CapacityProviderOperatorRoleArn": {
            "Fn::GetAtt": [
              "OpRole",
              "Arn"
            ]
          }
        },
        "VpcConfig": {
          "SecurityGroupIds": [
            {
              "Fn::GetAtt": [
                "Sg",
                "GroupId"
              ]
            }
          ],
          "SubnetIds": [
            {
              "Ref": "PrivA"
            },
            {
              "Ref": "PrivB"
            }
          ]
        }
      }
    },
    "R": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "base",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogGroup",
                    "logs:CreateLogStream",
                    "logs:PutLogEvents",
                    "ec2:CreateNetworkInterface",
                    "ec2:DescribeNetworkInterfaces",
                    "ec2:DeleteNetworkInterface",
                    "elasticfilesystem:ClientMount",
                    "elasticfilesystem:ClientWrite",
                    "sqs:SendMessage",
                    "sns:Publish"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "F": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Role": {
          "Fn::GetAtt": [
            "R",
            "Arn"
          ]
        },
        "Code": {
          "ZipFile": "def handler(e, c):\n    return 0\n"
        },
        "Runtime": "python3.13",
        "Handler": "index.handler",
        "CapacityProviderConfig": {
          "LambdaManagedInstancesCapacityProviderConfig": {
            "CapacityProviderArn": {
              "Fn::GetAtt": [
                "Cp",
                "Arn"
              ]
            }
          }
        },
        "FunctionScalingConfig": {
          "MinExecutionEnvironments": 0,
          "MaxExecutionEnvironments": 5
        }
      }
    }
  }
}
