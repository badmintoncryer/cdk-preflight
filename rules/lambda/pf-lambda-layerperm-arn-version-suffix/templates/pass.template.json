{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "L": {
      "Type": "AWS::Lambda::LayerVersion",
      "Properties": {
        "LayerName": "cdkpf-layer",
        "Content": {
          "S3Bucket": {
            "Fn::Sub": "cdkpf-fixtures-${AWS::AccountId}"
          },
          "S3Key": "l.zip"
        }
      }
    },
    "LP": {
      "Type": "AWS::Lambda::LayerVersionPermission",
      "Properties": {
        "Action": "lambda:GetLayerVersion",
        "LayerVersionArn": {
          "Ref": "L"
        },
        "Principal": {
          "Ref": "AWS::AccountId"
        }
      }
    }
  }
}
