{
  "Resources": {
    "F": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Role": {
          "Fn::GetAtt": [
            "R",
            "Arn"
          ]
        },
        "Code": {
          "ZipFile": "def handler(e, c):\n    return 0\n"
        },
        "Runtime": "python3.12",
        "Handler": "index.handler",
        "DeadLetterConfig": {
          "TargetArn": {
            "Fn::GetAtt": [
              "Q",
              "Arn"
            ]
          }
        }
      },
      "DependsOn": "R"
    },
    "R": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "dlq",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "sqs:SendMessage",
                  "Resource": {
                    "Fn::GetAtt": [
                      "Q",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Q": {
      "Type": "AWS::SQS::Queue",
      "Properties": {}
    }
  }
}
