{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "L": {
      "Type": "AWS::Lambda::LayerVersion",
      "Properties": {
        "LayerName": "cdkpf-layer",
        "Content": {
          "S3Bucket": {
            "Fn::Sub": "cdkpf-fixtures-${AWS::AccountId}"
          },
          "S3Key": "l.zip",
          "S3ObjectStorageMode": "REFERENCE",
          "S3ObjectVersion": "{{resolve:ssm:/cdkpf/fixtures/s3/l.zip-version}}"
        }
      }
    }
  }
}
