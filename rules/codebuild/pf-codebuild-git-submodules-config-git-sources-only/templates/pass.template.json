{
  "Resources": {
    "Main": {
      "Type": "AWS::CodeBuild::Project",
      "Properties": {
        "ServiceRole": "arn:aws:iam::214794239830:role/cdkpf-codesuite-probe",
        "Source": {
          "Type": "CODECOMMIT",
          "Location": "https://git-codecommit.us-east-1.amazonaws.com/v1/repos/cdkpf-probe",
          "GitSubmodulesConfig": {
            "FetchSubmodules": true
          }
        },
        "Artifacts": {
          "Type": "NO_ARTIFACTS"
        },
        "Environment": {
          "Type": "LINUX_CONTAINER",
          "ComputeType": "BUILD_GENERAL1_SMALL",
          "Image": "aws/codebuild/amazonlinux2-x86_64-standard:5.0"
        }
      }
    }
  }
}
