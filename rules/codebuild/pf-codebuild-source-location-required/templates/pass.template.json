{
  "Resources": {
    "Main": {
      "Type": "AWS::CodeBuild::Project",
      "Properties": {
        "ServiceRole": {
          "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/cdkpf-codesuite-probe"
        },
        "Source": {
          "Type": "S3",
          "Location": {
            "Fn::Sub": "cdkpf-fixtures-${AWS::AccountId}/src.zip"
          }
        },
        "Artifacts": {
          "Type": "NO_ARTIFACTS"
        },
        "Environment": {
          "Type": "LINUX_CONTAINER",
          "ComputeType": "BUILD_GENERAL1_SMALL",
          "Image": "aws/codebuild/amazonlinux2-x86_64-standard:5.0"
        },
        "SecondarySources": [
          {
            "Type": "S3",
            "Location": {
              "Fn::Sub": "cdkpf-fixtures-${AWS::AccountId}/src0.zip"
            },
            "SourceIdentifier": "s0"
          }
        ]
      }
    }
  }
}
