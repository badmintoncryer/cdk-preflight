{
  "Resources": {
    "Main": {
      "Type": "AWS::CodeBuild::Project",
      "Properties": {
        "ServiceRole": "arn:aws:iam::214794239830:role/cdkpf-codesuite-probe",
        "Source": {
          "Type": "S3",
          "Location": "cdkpf-codesuite-63/src.zip"
        },
        "Artifacts": {
          "Type": "NO_ARTIFACTS"
        },
        "Environment": {
          "Type": "LINUX_CONTAINER",
          "ComputeType": "BUILD_GENERAL1_SMALL",
          "Image": "aws/codebuild/amazonlinux2-x86_64-standard:5.0"
        },
        "Cache": {
          "Type": "LOCAL",
          "Modes": [
            "LOCAL_SOURCE_CACHE"
          ]
        }
      }
    }
  }
}
