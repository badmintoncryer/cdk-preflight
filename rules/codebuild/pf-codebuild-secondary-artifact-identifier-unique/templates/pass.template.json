{
  "Resources": {
    "Main": {
      "Type": "AWS::CodeBuild::Project",
      "Properties": {
        "ServiceRole": {
          "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/cdkpf-codesuite-probe"
        },
        "Source": {
          "Type": "NO_SOURCE",
          "BuildSpec": "version: 0.2\nphases:\n  build:\n    commands:\n      - echo hi\n"
        },
        "Artifacts": {
          "Type": "NO_ARTIFACTS"
        },
        "Environment": {
          "Type": "LINUX_CONTAINER",
          "ComputeType": "BUILD_GENERAL1_SMALL",
          "Image": "aws/codebuild/amazonlinux2-x86_64-standard:5.0"
        },
        "SecondaryArtifacts": [
          {
            "Type": "S3",
            "Location": {
              "Fn::Sub": "cdkpf-fixtures-${AWS::AccountId}"
            },
            "ArtifactIdentifier": "a0",
            "Path": "p0"
          },
          {
            "Type": "S3",
            "Location": {
              "Fn::Sub": "cdkpf-fixtures-${AWS::AccountId}"
            },
            "ArtifactIdentifier": "a1",
            "Path": "p1"
          }
        ]
      }
    }
  }
}
