{
  "Resources": {
    "Rg": {
      "Type": "AWS::Route53Resolver::FirewallRuleGroup",
      "Properties": {
        "Name": {
          "Fn::Join": [
            "",
            [
              "rg-",
              {
                "Fn::Select": [
                  2,
                  {
                    "Fn::Split": [
                      "/",
                      {
                        "Ref": "AWS::StackId"
                      }
                    ]
                  }
                ]
              }
            ]
          ]
        },
        "FirewallRules": [
          {
            "Priority": 101,
            "Action": "ALERT",
            "DnsThreatProtection": "DGA",
            "ConfidenceThreshold": "LOW"
          }
        ]
      }
    }
  }
}