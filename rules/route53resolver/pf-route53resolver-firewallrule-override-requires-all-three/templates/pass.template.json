{
  "Resources": {
    "Dl": {
      "Type": "AWS::Route53Resolver::FirewallDomainList",
      "Properties": {
        "Name": {
          "Fn::Join": [
            "",
            [
              "cdkpf-dl-",
              {
                "Fn::Select": [
                  2,
                  {
                    "Fn::Split": [
                      "/",
                      {
                        "Ref": "AWS::StackId"
                      }
                    ]
                  }
                ]
              }
            ]
          ]
        },
        "Domains": [
          "cdkpf-example.com"
        ]
      }
    },
    "Rg": {
      "Type": "AWS::Route53Resolver::FirewallRuleGroup",
      "Properties": {
        "Name": {
          "Fn::Join": [
            "",
            [
              "cdkpf-rg-",
              {
                "Fn::Select": [
                  2,
                  {
                    "Fn::Split": [
                      "/",
                      {
                        "Ref": "AWS::StackId"
                      }
                    ]
                  }
                ]
              }
            ]
          ]
        },
        "FirewallRules": [
          {
            "Priority": 101,
            "Action": "BLOCK",
            "FirewallDomainListId": {
              "Ref": "Dl"
            },
            "BlockResponse": "OVERRIDE",
            "BlockOverrideDnsType": "CNAME",
            "BlockOverrideDomain": "cdkpf-example.com.",
            "BlockOverrideTtl": 60
          }
        ]
      }
    }
  }
}