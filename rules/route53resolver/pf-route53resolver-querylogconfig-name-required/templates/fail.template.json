{
  "Resources": {
    "Lg": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Join": [
            "",
            [
              "/cdkpf/",
              {
                "Fn::Select": [
                  2,
                  {
                    "Fn::Split": [
                      "/",
                      {
                        "Ref": "AWS::StackId"
                      }
                    ]
                  }
                ]
              }
            ]
          ]
        },
        "RetentionInDays": 1
      }
    },
    "Qlc": {
      "Type": "AWS::Route53Resolver::ResolverQueryLoggingConfig",
      "Properties": {
        "DestinationArn": {
          "Fn::GetAtt": [
            "Lg",
            "Arn"
          ]
        }
      }
    }
  }
}