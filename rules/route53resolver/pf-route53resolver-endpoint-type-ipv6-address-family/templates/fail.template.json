{
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.0.0.0/16"
      }
    },
    "SubnetA": {
      "Type": "AWS::EC2::Subnet",
      "DependsOn": "Ipv6Cidr",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.0.0.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "Ipv6CidrBlock": {
          "Fn::Select": [
            0,
            {
              "Fn::Cidr": [
                {
                  "Fn::Select": [
                    0,
                    {
                      "Fn::GetAtt": [
                        "Vpc",
                        "Ipv6CidrBlocks"
                      ]
                    }
                  ]
                },
                2,
                64
              ]
            }
          ]
        }
      }
    },
    "SubnetB": {
      "Type": "AWS::EC2::Subnet",
      "DependsOn": "Ipv6Cidr",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.0.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "Ipv6CidrBlock": {
          "Fn::Select": [
            1,
            {
              "Fn::Cidr": [
                {
                  "Fn::Select": [
                    0,
                    {
                      "Fn::GetAtt": [
                        "Vpc",
                        "Ipv6CidrBlocks"
                      ]
                    }
                  ]
                },
                2,
                64
              ]
            }
          ]
        }
      }
    },
    "Sg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "cdk-preflight resolver endpoint fixture",
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "Ipv6Cidr": {
      "Type": "AWS::EC2::VPCCidrBlock",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AmazonProvidedIpv6CidrBlock": true
      }
    },
    "Endpoint": {
      "Type": "AWS::Route53Resolver::ResolverEndpoint",
      "Properties": {
        "Direction": "OUTBOUND",
        "SecurityGroupIds": [
          {
            "Ref": "Sg"
          }
        ],
        "IpAddresses": [
          {
            "SubnetId": {
              "Ref": "SubnetA"
            },
            "Ip": "10.0.0.53"
          },
          {
            "SubnetId": {
              "Ref": "SubnetB"
            },
            "Ip": "10.0.1.53"
          }
        ],
        "ResolverEndpointType": "IPV6"
      }
    }
  }
}