{
  "Resources": {
    "S": {
      "Type": "AWS::Kinesis::Stream",
      "Properties": {
        "ShardCount": 1
      }
    },
    "T": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          }
        ],
        "BillingMode": "PAY_PER_REQUEST",
        "KinesisStreamSpecification": {
          "StreamArn": {
            "Fn::GetAtt": [
              "S",
              "Arn"
            ]
          },
          "ApproximateCreationDateTimePrecision": "SECOND"
        }
      }
    }
  }
}
