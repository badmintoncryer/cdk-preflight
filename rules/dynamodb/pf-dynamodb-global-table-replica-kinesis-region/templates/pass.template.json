{
  "Resources": {
    "S": {
      "Type": "AWS::Kinesis::Stream",
      "Properties": {
        "ShardCount": 1
      }
    },
    "GT": {
      "Type": "AWS::DynamoDB::GlobalTable",
      "Properties": {
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          }
        ],
        "BillingMode": "PAY_PER_REQUEST",
        "StreamSpecification": {
          "StreamViewType": "NEW_AND_OLD_IMAGES"
        },
        "Replicas": [
          {
            "Region": "us-east-1",
            "KinesisStreamSpecification": {
              "StreamArn": {
                "Fn::GetAtt": [
                  "S",
                  "Arn"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
