{
  "Resources": {
    "GT": {
      "Type": "AWS::DynamoDB::GlobalTable",
      "Properties": {
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          }
        ],
        "BillingMode": "PAY_PER_REQUEST",
        "StreamSpecification": {
          "StreamViewType": "NEW_AND_OLD_IMAGES"
        },
        "Replicas": [
          {
            "Region": "us-east-1"
          },
          {
            "Region": "us-east-2"
          },
          {
            "Region": "us-west-2"
          }
        ],
        "MultiRegionConsistency": "STRONG",
        "TimeToLiveSpecification": {
          "Enabled": true,
          "AttributeName": "expiresAt"
        }
      }
    }
  }
}
