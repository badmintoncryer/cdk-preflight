{
 "AWSTemplateFormatVersion": "2010-09-09",
 "Resources": {
  "S1": {
   "Type": "AWS::Scheduler::Schedule",
   "Properties": {
    "FlexibleTimeWindow": {
     "Mode": "OFF"
    },
    "ScheduleExpression": "cron(0 20 * * ? *)",
    "State": "DISABLED",
    "Target": {
     "Arn": "arn:aws:lambda:us-east-1:214794239830:function:cdkpf-nonexistent",
     "RoleArn": {
      "Fn::GetAtt": [
       "Role",
       "Arn"
      ]
     }
    }
   }
  },
  "Role": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Service": "scheduler.amazonaws.com"
       },
       "Action": "sts:AssumeRole"
      }
     ]
    }
   }
  }
 }
}
