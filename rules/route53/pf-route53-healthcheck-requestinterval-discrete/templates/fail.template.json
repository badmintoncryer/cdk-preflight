{
  "Resources": {
    "HC": {
      "Type": "AWS::Route53::HealthCheck",
      "Properties": {
        "HealthCheckConfig": {
          "Type": "HTTP",
          "FullyQualifiedDomainName": "example.com",
          "Port": 80,
          "RequestInterval": 20,
          "FailureThreshold": 3
        }
      }
    }
  }
}