{
  "Resources": {
    "HC": {
      "Type": "AWS::Route53::HealthCheck",
      "Properties": {
        "HealthCheckConfig": {
          "Type": "HTTPS",
          "FullyQualifiedDomainName": "example.com",
          "Port": 443,
          "RequestInterval": 30,
          "FailureThreshold": 3
        }
      }
    },
    "Zone": {
      "Type": "AWS::Route53::HostedZone",
      "Properties": {
        "Name": "cdkpf-example.com."
      }
    },
    "Rec": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "Name": "www.cdkpf-example.com",
        "Type": "A",
        "TTL": "60",
        "ResourceRecords": [
          "192.0.2.1"
        ],
        "SetIdentifier": "s1",
        "Failover": "PRIMARY",
        "HealthCheckId": {
          "Ref": "HC"
        },
        "HostedZoneId": {
          "Ref": "Zone"
        }
      }
    }
  }
}