{
  "Resources": {
    "Alarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-alarm"
        },
        "Namespace": "cdkpf",
        "MetricName": "probe",
        "ComparisonOperator": "GreaterThanThreshold",
        "EvaluationPeriods": 1,
        "Period": 60,
        "Statistic": "Average",
        "Threshold": 1,
        "TreatMissingData": "notBreaching"
      }
    },
    "HC": {
      "Type": "AWS::Route53::HealthCheck",
      "Properties": {
        "HealthCheckConfig": {
          "Type": "HTTP",
          "FullyQualifiedDomainName": "example.com",
          "Port": 80,
          "RequestInterval": 30,
          "FailureThreshold": 3
        }
      }
    }
  }
}