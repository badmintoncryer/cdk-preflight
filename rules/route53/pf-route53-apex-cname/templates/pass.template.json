{
  "Resources": {
    "Zone": {
      "Type": "AWS::Route53::HostedZone",
      "Properties": {
        "Name": "example.org."
      }
    },
    "Rec": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "Zone"
        },
        "Name": "www.example.org.",
        "Type": "CNAME",
        "ResourceRecords": [
          "target.example.net."
        ],
        "TTL": "300"
      }
    }
  }
}
