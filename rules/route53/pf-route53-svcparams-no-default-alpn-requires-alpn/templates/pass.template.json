{
  "Resources": {
    "Zone": {
      "Type": "AWS::Route53::HostedZone",
      "Properties": {
        "Name": "cdkpf-example.com."
      }
    },
    "Rec": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "Name": "www.cdkpf-example.com",
        "Type": "HTTPS",
        "TTL": "60",
        "ResourceRecords": [
          "1 example.net. alpn=h2,h3 no-default-alpn"
        ],
        "HostedZoneId": {
          "Ref": "Zone"
        }
      }
    }
  }
}