{
  "Resources": {
    "HC": {
      "Type": "AWS::Route53::HealthCheck",
      "Properties": {
        "HealthCheckConfig": {
          "Type": "HTTP2",
          "FullyQualifiedDomainName": "example.com",
          "Port": 80,
          "RequestInterval": 30,
          "FailureThreshold": 3
        }
      }
    }
  }
}