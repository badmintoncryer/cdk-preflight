{
  "Resources": {
    "Alarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-alarm"
        },
        "ComparisonOperator": "GreaterThanThreshold",
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "Metrics": [
          {
            "Id": "e1",
            "Expression": "m1+m2",
            "ReturnData": true
          },
          {
            "Id": "m1",
            "ReturnData": false,
            "MetricStat": {
              "Metric": {
                "Namespace": "cdkpf",
                "MetricName": "a"
              },
              "Period": 60,
              "Stat": "Average"
            }
          },
          {
            "Id": "m2",
            "ReturnData": false,
            "MetricStat": {
              "Metric": {
                "Namespace": "cdkpf",
                "MetricName": "b"
              },
              "Period": 60,
              "Stat": "Average"
            }
          }
        ]
      }
    },
    "HC": {
      "Type": "AWS::Route53::HealthCheck",
      "Properties": {
        "HealthCheckConfig": {
          "Type": "CLOUDWATCH_METRIC",
          "AlarmIdentifier": {
            "Name": {
              "Ref": "Alarm"
            },
            "Region": "us-east-1"
          },
          "InsufficientDataHealthStatus": "Healthy"
        }
      },
      "DependsOn": "Alarm"
    }
  }
}