{
  "Resources": {
    "HC": {
      "Type": "AWS::Route53::HealthCheck",
      "Properties": {
        "HealthCheckConfig": {
          "Type": "HTTP",
          "FullyQualifiedDomainName": "example.com",
          "Port": 80,
          "RequestInterval": 30,
          "FailureThreshold": 3,
          "Regions": [
            "us-east-1",
            "us-west-1",
            "eu-central-1"
          ]
        }
      }
    }
  }
}