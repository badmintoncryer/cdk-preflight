{
  "Resources": {
    "HC": {
      "Type": "AWS::Route53::HealthCheck",
      "Properties": {
        "HealthCheckConfig": {
          "Type": "HTTP",
          "Port": 80,
          "RequestInterval": 30,
          "FailureThreshold": 3,
          "IPAddress": "10.0.0.10"
        }
      }
    }
  }
}