{
  "Resources": {
    "CdkpfGfWs": {
      "Type": "AWS::Grafana::Workspace",
      "Properties": {
        "Name": "cdkpf-gf-desc",
        "AccountAccessType": "CURRENT_ACCOUNT",
        "AuthenticationProviders": [
          "SAML"
        ],
        "PermissionType": "CUSTOMER_MANAGED",
        "RoleArn": {
          "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/cdkpf-grafana"
        },
        "Description": "CPU > 80"
      }
    }
  }
}
