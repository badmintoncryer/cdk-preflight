{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "AggregatorBoth": {
      "Type": "AWS::Config::ConfigurationAggregator",
      "Properties": {
        "AccountAggregationSources": [
          {
            "AccountIds": [
              {
                "Ref": "AWS::AccountId"
              }
            ],
            "AllAwsRegions": true
          }
        ],
        "OrganizationAggregationSource": {
          "RoleArn": {
            "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/cdkpf-no-such-role-69"
          },
          "AllAwsRegions": true
        }
      }
    },
    "AggregatorNeither": {
      "Type": "AWS::Config::ConfigurationAggregator",
      "Properties": {
        "ConfigurationAggregatorName": "cdkpf-c69-agg-no-source"
      }
    }
  }
}
