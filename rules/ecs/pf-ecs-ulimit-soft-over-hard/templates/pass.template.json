{
  "Resources": {
    "TD": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "pfulimitsoftoverhard",
        "NetworkMode": "bridge",
        "RequiresCompatibilities": [
          "EC2"
        ],
        "ContainerDefinitions": [
          {
            "Name": "app",
            "Image": "public.ecr.aws/nginx/nginx:latest",
            "Memory": 512,
            "Essential": true,
            "Ulimits": [
              {
                "Name": "nofile",
                "SoftLimit": 1024,
                "HardLimit": 2048
              }
            ]
          }
        ]
      }
    }
  }
}