{
  "Resources": {
    "TD": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "pfsecretswithoutexecutionrole",
        "Cpu": "256",
        "Memory": "512",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "ContainerDefinitions": [
          {
            "Name": "app",
            "Image": "public.ecr.aws/nginx/nginx:latest",
            "Essential": true,
            "Secrets": [
              {
                "Name": "S",
                "ValueFrom": "arn:aws:ssm:us-east-1:123456789012:parameter/pf"
              }
            ]
          }
        ]
      }
    }
  }
}