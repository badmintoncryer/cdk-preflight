{
  "Resources": {
    "Td": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "RequiresCompatibilities": [
          "EC2"
        ],
        "ContainerDefinitions": [
          {
            "Name": "c0",
            "Image": "public.ecr.aws/docker/library/busybox:latest",
            "Memory": 128,
            "Essential": true,
            "ResourceRequirements": [
              {
                "Type": "GPU",
                "SharingStrategy": {
                  "NvidiaMps": {
                    "Memory": 2000
                  }
                }
              }
            ]
          },
          {
            "Name": "c1",
            "Image": "public.ecr.aws/docker/library/busybox:latest",
            "Memory": 128,
            "Essential": false,
            "ResourceRequirements": [
              {
                "Type": "GPU",
                "Value": "1"
              }
            ]
          }
        ]
      }
    }
  }
}
