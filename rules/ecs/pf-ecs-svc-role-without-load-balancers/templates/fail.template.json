{
  "Resources": {
    "Svc": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "TaskDefinition": {
          "Ref": "TD"
        },
        "DesiredCount": 0,
        "LaunchType": "EC2",
        "Role": {
          "Fn::GetAtt": [
            "SvcRole",
            "Arn"
          ]
        }
      }
    },
    "TD": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "pfsvcrolewithoutloadbalancers",
        "NetworkMode": "bridge",
        "RequiresCompatibilities": [
          "EC2"
        ],
        "ContainerDefinitions": [
          {
            "Name": "app",
            "Image": "public.ecr.aws/nginx/nginx:latest",
            "Memory": 512,
            "Essential": true
          }
        ]
      }
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {}
    },
    "SvcRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    }
  }
}