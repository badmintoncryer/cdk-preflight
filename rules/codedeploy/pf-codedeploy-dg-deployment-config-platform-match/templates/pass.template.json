{
  "Resources": {
    "R1": {
      "Type": "AWS::CodeDeploy::Application",
      "Properties": {
        "ComputePlatform": "Server"
      }
    },
    "R2": {
      "Type": "AWS::CodeDeploy::DeploymentGroup",
      "Properties": {
        "ApplicationName": {
          "Ref": "R1"
        },
        "ServiceRoleArn": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/cdkpf-codesuite-probe"
        },
        "Ec2TagFilters": [
          {
            "Key": "k",
            "Value": "v",
            "Type": "KEY_AND_VALUE"
          }
        ],
        "DeploymentConfigName": "CodeDeployDefault.OneAtATime"
      }
    },
    "R3": {
      "Type": "AWS::CodeDeploy::DeploymentGroup",
      "Properties": {
        "ApplicationName": {
          "Ref": "R1"
        },
        "ServiceRoleArn": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/cdkpf-codesuite-probe"
        },
        "Ec2TagFilters": [
          {
            "Key": "k",
            "Value": "v",
            "Type": "KEY_AND_VALUE"
          }
        ],
        "DeploymentConfigName": {
          "Ref": "R4"
        }
      }
    },
    "R4": {
      "Type": "AWS::CodeDeploy::DeploymentConfig",
      "Properties": {
        "ComputePlatform": "Server",
        "MinimumHealthyHosts": {
          "Type": "FLEET_PERCENT",
          "Value": 75
        }
      }
    }
  }
}
