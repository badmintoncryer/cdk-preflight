{
  "Resources": {
    "R1": {
      "Type": "AWS::CodeDeploy::Application",
      "Properties": {
        "ComputePlatform": "Server"
      }
    },
    "R2": {
      "Type": "AWS::CodeDeploy::DeploymentGroup",
      "Properties": {
        "ApplicationName": {
          "Ref": "R1"
        },
        "ServiceRoleArn": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/cdkpf-codesuite-probe"
        },
        "Ec2TagFilters": [
          {
            "Key": "cdkpf-matches-nothing",
            "Value": "x",
            "Type": "KEY_AND_VALUE"
          }
        ],
        "DeploymentStyle": {
          "DeploymentType": "IN_PLACE",
          "DeploymentOption": "WITH_TRAFFIC_CONTROL"
        },
        "LoadBalancerInfo": {
          "ElbInfoList": [
            {
              "Name": "cdkpf-nope"
            }
          ]
        }
      }
    }
  }
}