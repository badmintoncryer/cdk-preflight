{
  "Resources": {
    "R1": {
      "Type": "AWS::CodeDeploy::Application",
      "Properties": {
        "ComputePlatform": "Server"
      }
    },
    "R2": {
      "Type": "AWS::CodeDeploy::DeploymentGroup",
      "Properties": {
        "ApplicationName": {
          "Ref": "R1"
        },
        "ServiceRoleArn": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/cdkpf-codesuite-probe"
        },
        "OnPremisesInstanceTagFilters": [
          {
            "Key": "k",
            "Value": "v",
            "Type": "KEY_AND_VALUE"
          }
        ],
        "OnPremisesTagSet": {
          "OnPremisesTagSetList": [
            {
              "OnPremisesTagGroup": [
                {
                  "Key": "k",
                  "Value": "v",
                  "Type": "KEY_AND_VALUE"
                }
              ]
            }
          ]
        }
      }
    }
  }
}
