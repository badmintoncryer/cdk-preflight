{
  "Resources": {
    "R1": {
      "Type": "AWS::CodeDeploy::DeploymentConfig",
      "Properties": {
        "ComputePlatform": "Server",
        "MinimumHealthyHosts": {
          "Type": "FLEET_PERCENT",
          "Value": 75
        },
        "DeploymentConfigName": {
          "Fn::Sub": "CodeDeployDefault-${AWS::StackName}"
        }
      }
    }
  }
}
