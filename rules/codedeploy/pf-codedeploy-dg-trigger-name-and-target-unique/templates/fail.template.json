{
  "Resources": {
    "R1": {
      "Type": "AWS::CodeDeploy::Application",
      "Properties": {
        "ComputePlatform": "Server"
      }
    },
    "T0": {
      "Type": "AWS::SNS::Topic"
    },
    "T1": {
      "Type": "AWS::SNS::Topic"
    },
    "T2": {
      "Type": "AWS::SNS::Topic"
    },
    "R2": {
      "Type": "AWS::CodeDeploy::DeploymentGroup",
      "Properties": {
        "ApplicationName": {
          "Ref": "R1"
        },
        "ServiceRoleArn": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/cdkpf-codesuite-probe"
        },
        "Ec2TagFilters": [
          {
            "Key": "cdkpf-matches-nothing",
            "Value": "x",
            "Type": "KEY_AND_VALUE"
          }
        ],
        "TriggerConfigurations": [
          {
            "TriggerName": "dup",
            "TriggerTargetArn": {
              "Ref": "T0"
            },
            "TriggerEvents": [
              "DeploymentSuccess"
            ]
          },
          {
            "TriggerName": "dup",
            "TriggerTargetArn": {
              "Ref": "T1"
            },
            "TriggerEvents": [
              "DeploymentSuccess"
            ]
          },
          {
            "TriggerName": "t2",
            "TriggerTargetArn": {
              "Ref": "T2"
            },
            "TriggerEvents": [
              "DeploymentSuccess"
            ]
          },
          {
            "TriggerName": "t3",
            "TriggerTargetArn": {
              "Ref": "T2"
            },
            "TriggerEvents": [
              "DeploymentSuccess"
            ]
          }
        ]
      }
    }
  }
}