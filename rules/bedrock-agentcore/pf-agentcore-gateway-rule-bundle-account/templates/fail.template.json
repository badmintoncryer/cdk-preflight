{
 "AWSTemplateFormatVersion": "2010-09-09",
 "Resources": {
  "Role": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Service": "bedrock-agentcore.amazonaws.com"
       },
       "Action": "sts:AssumeRole"
      }
     ]
    },
    "Policies": [
     {
      "PolicyName": "p",
      "PolicyDocument": {
       "Version": "2012-10-17",
       "Statement": [
        {
         "Effect": "Allow",
         "Action": [
          "logs:*"
         ],
         "Resource": "*"
        }
       ]
      }
     }
    ]
   }
  },
  "G": {
   "Type": "AWS::BedrockAgentCore::Gateway",
   "Properties": {
    "Name": "cdkpf-gateway-rule-bundle-account-f",
    "AuthorizerType": "AWS_IAM",
    "RoleArn": {
     "Fn::GetAtt": [
      "Role",
      "Arn"
     ]
    },
    "ProtocolType": "MCP"
   }
  },
  "R": {
   "Type": "AWS::BedrockAgentCore::GatewayRule",
   "Properties": {
    "GatewayIdentifier": {
     "Fn::GetAtt": [
      "G",
      "GatewayIdentifier"
     ]
    },
    "Priority": 5,
    "Actions": [
     {
      "ConfigurationBundle": {
       "WeightedOverride": {
        "TrafficSplit": [
         {
          "Name": "a",
          "Weight": 50,
          "ConfigurationBundle": {
           "BundleArn": "arn:aws:bedrock-agentcore:us-east-1:111122223333:configuration-bundle/cdkpf_other-abcdefghij",
           "BundleVersion": "11111111-2222-3333-4444-555555555555"
          }
         },
         {
          "Name": "b",
          "Weight": 50,
          "ConfigurationBundle": {
           "BundleArn": "arn:aws:bedrock-agentcore:us-east-1:111122223333:configuration-bundle/cdkpf_other-abcdefghij",
           "BundleVersion": "11111111-2222-3333-4444-555555555555"
          }
         }
        ]
       }
      }
     }
    ]
   }
  }
 }
}
