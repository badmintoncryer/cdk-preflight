{
  "Resources": {
    "Memory": {
      "Type": "AWS::BedrockAgentCore::Memory",
      "Properties": {
        "Name": "cdkpf_memns_fail",
        "EventExpiryDuration": 30,
        "MemoryStrategies": [
          {
            "SemanticMemoryStrategy": {
              "Name": "facts",
              "Namespaces": [
                "/actor/{actorId}/",
                "/session/{sessionId}/"
              ]
            }
          }
        ]
      }
    }
  }
}