      "GatewayIdentifier"
     ]
    },
    "Name": "rt",
    "TargetConfiguration": {
     "Http": {
      "AgentcoreRuntime": {
       "Arn": "arn:aws:bedrock-agentcore:eu-west-1:214794239830:runtime/cdkpf_nosuch-abcdefghij"
      }
     }
    },
