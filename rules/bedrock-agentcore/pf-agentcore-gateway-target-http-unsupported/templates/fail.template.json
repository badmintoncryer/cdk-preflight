{
 "Resources": {
  "Role": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Service": "bedrock-agentcore.amazonaws.com"
       },
       "Action": "sts:AssumeRole"
      }
     ]
    },
    "Policies": [
     {
      "PolicyName": "p",
      "PolicyDocument": {
       "Version": "2012-10-17",
       "Statement": [
        {
         "Effect": "Allow",
         "Action": [
          "logs:*",
          "bedrock:InvokeModel"
         ],
         "Resource": "*"
        }
       ]
      }
     }
    ]
   }
  },
  "G": {
   "Type": "AWS::BedrockAgentCore::Gateway",
   "Properties": {
    "Name": "cdkpf-gtrtf",
