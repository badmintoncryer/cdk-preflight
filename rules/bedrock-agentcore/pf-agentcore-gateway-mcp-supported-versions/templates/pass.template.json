{
  "Resources": {
    "GatewayRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "bedrock-agentcore.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    },
    "Gateway": {
      "Type": "AWS::BedrockAgentCore::Gateway",
      "Properties": {
        "Name": "cdkpf-gwmcpver-pass",
        "ProtocolType": "MCP",
        "AuthorizerType": "AWS_IAM",
        "RoleArn": {
          "Fn::GetAtt": [
            "GatewayRole",
            "Arn"
          ]
        },
        "ProtocolConfiguration": {
          "Mcp": {
            "SupportedVersions": [
              "2025-06-18"
            ]
          }
        }
      }
    }
  }
}