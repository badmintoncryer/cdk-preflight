{
  "Resources": {
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "bedrock-agentcore.amazonaws.com",
                  "lambda.amazonaws.com"
                ]
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "agentcore",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "lambda:InvokeFunction",
                    "bedrock:InvokeModel",
                    "logs:*",
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "Gw": {
      "Type": "AWS::BedrockAgentCore::Gateway",
      "Properties": {
        "Name": "cdkpf-cdkpf-cedar-pass",
        "ProtocolType": "MCP",
        "AuthorizerType": "AWS_IAM",
        "RoleArn": {
          "Fn::GetAtt": [
            "Role",
            "Arn"
          ]
        }
      }
    },
    "Engine": {
      "Type": "AWS::BedrockAgentCore::PolicyEngine",
      "Properties": {
        "Name": "cdkpf_cedar_pass_engine"
      }
    },
    "Policy": {
      "Type": "AWS::BedrockAgentCore::Policy",
      "Properties": {
        "Name": "cdkpf_cedar_pass",
        "PolicyEngineId": {
          "Fn::GetAtt": [
            "Engine",
            "PolicyEngineId"
          ]
        },
        "Definition": {
          "Cedar": {
            "Statement": {
              "Fn::Sub": "permit(principal, action == AgentCore::Action::\"tools___get_weather\", resource == AgentCore::Gateway::\"${Gw.GatewayArn}\") when { context.input.city == \"Tokyo\" };"
            }
          }
        }
      },
      "DependsOn": [
        "Target"
      ]
    },
    "Fn": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "python3.12",
        "Handler": "index.handler",
        "Role": {
          "Fn::GetAtt": [
            "Role",
            "Arn"
          ]
        },
        "Code": {
          "ZipFile": "def handler(e, c):\n    return e\n"
        }
      }
    },
    "Target": {
      "Type": "AWS::BedrockAgentCore::GatewayTarget",
      "Properties": {
        "GatewayIdentifier": {
          "Fn::GetAtt": [
            "Gw",
            "GatewayIdentifier"
          ]
        },
        "Name": "tools",
        "TargetConfiguration": {
          "Mcp": {
            "Lambda": {
              "LambdaArn": {
                "Fn::GetAtt": [
                  "Fn",
                  "Arn"
                ]
              },
              "ToolSchema": {
                "InlinePayload": [
                  {
                    "Name": "get_weather",
                    "Description": "Returns the weather",
                    "InputSchema": {
                      "Type": "object",
                      "Properties": {
                        "city": {
                          "Type": "string"
                        }
                      },
                      "Required": [
                        "city"
                      ]
                    }
                  }
                ]
              }
            }
          }
        },
        "CredentialProviderConfigurations": [
          {
            "CredentialProviderType": "GATEWAY_IAM_ROLE"
          }
        ]
      }
    }
  }
}