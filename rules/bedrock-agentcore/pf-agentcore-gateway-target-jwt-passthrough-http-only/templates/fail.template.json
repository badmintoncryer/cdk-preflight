{
 "AWSTemplateFormatVersion": "2010-09-09",
 "Resources": {
  "Role": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Service": "bedrock-agentcore.amazonaws.com"
       },
       "Action": "sts:AssumeRole"
      }
     ]
    },
    "Policies": [
     {
      "PolicyName": "p",
      "PolicyDocument": {
       "Version": "2012-10-17",
       "Statement": [
        {
         "Effect": "Allow",
         "Action": [
          "logs:*"
         ],
         "Resource": "*"
        }
       ]
      }
     }
    ]
   }
  },
  "G": {
   "Type": "AWS::BedrockAgentCore::Gateway",
   "Properties": {
    "Name": "cdkpf-gateway-target-jwt-passthrough-f",
    "AuthorizerType": "CUSTOM_JWT",
    "RoleArn": {
     "Fn::GetAtt": [
      "Role",
      "Arn"
     ]
    },
    "ProtocolType": "MCP",
    "AuthorizerConfiguration": {
     "CustomJWTAuthorizer": {
      "DiscoveryUrl": "https://accounts.google.com/.well-known/openid-configuration",
      "AllowedClients": [
       "my-oauth-client-id"
      ]
     }
    }
   }
  },
  "T": {
   "Type": "AWS::BedrockAgentCore::GatewayTarget",
   "Properties": {
    "GatewayIdentifier": {
     "Fn::GetAtt": [
      "G",
      "GatewayIdentifier"
     ]
    },
    "Name": "t1",
    "TargetConfiguration": {
     "Mcp": {
      "McpServer": {
       "Endpoint": "https://example.com/mcp"
      }
     }
    },
    "CredentialProviderConfigurations": [
     {
      "CredentialProviderType": "JWT_PASSTHROUGH"
     }
    ]
   }
  }
 }
}
