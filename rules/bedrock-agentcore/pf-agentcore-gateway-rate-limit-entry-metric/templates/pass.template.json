{
 "AWSTemplateFormatVersion": "2010-09-09",
 "Resources": {
  "Role": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Service": "bedrock-agentcore.amazonaws.com"
       },
       "Action": "sts:AssumeRole"
      }
     ]
    },
    "Policies": [
     {
      "PolicyName": "p",
      "PolicyDocument": {
       "Version": "2012-10-17",
       "Statement": [
        {
         "Effect": "Allow",
         "Action": [
          "logs:*"
         ],
         "Resource": "*"
        }
       ]
      }
     }
    ]
   }
  },
  "G": {
   "Type": "AWS::BedrockAgentCore::Gateway",
   "Properties": {
    "Name": "cdkpf-gateway-rate-limit-entry-metri-p",
    "AuthorizerType": "AWS_IAM",
    "RoleArn": {
     "Fn::GetAtt": [
      "Role",
      "Arn"
     ]
    },
    "ProtocolType": "MCP"
   }
  },
  "L": {
   "Type": "AWS::BedrockAgentCore::GatewayRateLimit",
   "Properties": {
    "GatewayIdentifier": {
     "Fn::GetAtt": [
      "G",
      "GatewayIdentifier"
     ]
    },
    "DimensionKeys": [
     "targetName"
    ],
    "Entries": [
     {
      "Dimensions": {
       "targetName": "*"
      },
      "Requests": [
       {
        "Rate": 10,
        "Period": "second"
       }
      ]
     }
    ]
   }
  }
 }
}
