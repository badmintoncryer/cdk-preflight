{
  "Resources": {
    "Profile": {
      "Type": "AWS::Route53Profiles::Profile",
      "Properties": {
        "Name": {
          "Fn::Join": [
            "",
            [
              "cdkpf-pr-",
              {
                "Fn::Select": [
                  2,
                  {
                    "Fn::Split": [
                      "/",
                      {
                        "Ref": "AWS::StackId"
                      }
                    ]
                  }
                ]
              }
            ]
          ]
        }
      }
    },
    "Dl": {
      "Type": "AWS::Route53Resolver::FirewallDomainList",
      "Properties": {
        "Name": {
          "Fn::Join": [
            "",
            [
              "cdkpf-dl-",
              {
                "Fn::Select": [
                  2,
                  {
                    "Fn::Split": [
                      "/",
                      {
                        "Ref": "AWS::StackId"
                      }
                    ]
                  }
                ]
              }
            ]
          ]
        },
        "Domains": [
          "cdkpf-example.com"
        ]
      }
    },
    "Rg": {
      "Type": "AWS::Route53Resolver::FirewallRuleGroup",
      "Properties": {
        "Name": {
          "Fn::Join": [
            "",
            [
              "cdkpf-rg-",
              {
                "Fn::Select": [
                  2,
                  {
                    "Fn::Split": [
                      "/",
                      {
                        "Ref": "AWS::StackId"
                      }
                    ]
                  }
                ]
              }
            ]
          ]
        },
        "FirewallRules": [
          {
            "Priority": 101,
            "Action": "ALERT",
            "FirewallDomainListId": {
              "Ref": "Dl"
            }
          }
        ]
      }
    },
    "ResAssoc": {
      "Type": "AWS::Route53Profiles::ProfileResourceAssociation",
      "Properties": {
        "Name": {
          "Fn::Join": [
            "",
            [
              "cdkpf-ra-",
              {
                "Fn::Select": [
                  2,
                  {
                    "Fn::Split": [
                      "/",
                      {
                        "Ref": "AWS::StackId"
                      }
                    ]
                  }
                ]
              }
            ]
          ]
        },
        "ProfileId": {
          "Ref": "Profile"
        },
        "ResourceArn": {
          "Fn::GetAtt": [
            "Rg",
            "Arn"
          ]
        },
        "ResourceProperties": "priority=101"
      }
    }
  }
}