{
  "Resources": {
    "Ns": {
      "Type": "AWS::ServiceDiscovery::PublicDnsNamespace",
      "Properties": {
        "Name": "arwp.cdkpf67.appnao.com"
      }
    },
    "Svc": {
      "Type": "AWS::ServiceDiscovery::Service",
      "Properties": {
        "Name": "backend",
        "NamespaceId": {
          "Ref": "Ns"
        },
        "DnsConfig": {
          "DnsRecords": [
            {
              "Type": "A",
              "TTL": 60
            }
          ],
          "RoutingPolicy": "WEIGHTED"
        }
      }
    },
    "Inst": {
      "Type": "AWS::ServiceDiscovery::Instance",
      "Properties": {
        "ServiceId": {
          "Fn::GetAtt": [
            "Svc",
            "Id"
          ]
        },
        "InstanceId": "inst1",
        "InstanceAttributes": {
          "AWS_ALIAS_DNS_NAME": {
            "Fn::GetAtt": [
              "Alb",
              "DNSName"
            ]
          }
        }
      }
    },
    "Alb": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Type": "application",
        "Scheme": "internet-facing",
        "Subnets": [
          "subnet-2e0a500f",
          "subnet-ab11fde7"
        ]
      }
    }
  }
}
