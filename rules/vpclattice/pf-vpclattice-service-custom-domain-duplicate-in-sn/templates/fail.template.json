{
 "AWSTemplateFormatVersion": "2010-09-09",
 "Resources": {
  "Sn": {
   "Type": "AWS::VpcLattice::ServiceNetwork",
   "Properties": {
    "Name": "cdkpf-363-s2-20-f-n"
   }
  },
  "SvcA": {
   "Type": "AWS::VpcLattice::Service",
   "Properties": {
    "Name": "cdkpf-363-s2-20-f-a",
    "CustomDomainName": "cdkpf-363-s2-20-f.cdkpf-363.example.com"
   }
  },
  "SvcB": {
   "Type": "AWS::VpcLattice::Service",
   "Properties": {
    "Name": "cdkpf-363-s2-20-f-b",
    "CustomDomainName": "cdkpf-363-s2-20-f.cdkpf-363.example.com"
   }
  },
  "A": {
   "Type": "AWS::VpcLattice::ServiceNetworkServiceAssociation",
   "Properties": {
    "ServiceIdentifier": {
     "Ref": "SvcA"
    },
    "ServiceNetworkIdentifier": {
     "Ref": "Sn"
    }
   }
  },
  "B": {
   "Type": "AWS::VpcLattice::ServiceNetworkServiceAssociation",
   "Properties": {
    "ServiceIdentifier": {
     "Ref": "SvcB"
    },
    "ServiceNetworkIdentifier": {
     "Ref": "Sn"
    }
   },
   "DependsOn": [
    "A"
   ]
  }
 }
}
