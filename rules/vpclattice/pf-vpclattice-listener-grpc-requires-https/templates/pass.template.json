{
 "AWSTemplateFormatVersion": "2010-09-09",
 "Resources": {
  "Svc": {
   "Type": "AWS::VpcLattice::Service",
   "Properties": {
    "Name": "cdkpf-363-s2-03-p"
   }
  },
  "TG": {
   "Type": "AWS::VpcLattice::TargetGroup",
   "Properties": {
    "Name": "cdkpf-363-s2-03-p-t",
    "Type": "INSTANCE",
    "Config": {
     "Port": 443,
     "Protocol": "HTTPS",
     "VpcIdentifier": "vpc-4331593e",
     "ProtocolVersion": "GRPC"
    }
   }
  },
  "Lis": {
