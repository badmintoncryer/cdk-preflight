{
 "AWSTemplateFormatVersion": "2010-09-09",
 "Resources": {
  "Svc": {
   "Type": "AWS::VpcLattice::Service",
   "Properties": {
    "Name": "cdkpf-363-s2-12-f",
    "CustomDomainName": "cdkpf-363-s2-12-f.cdkpf-363.example.com"
   }
  },
  "TG": {
   "Type": "AWS::VpcLattice::TargetGroup",
   "Properties": {
    "Name": "cdkpf-363-s2-12-f-t",
    "Type": "INSTANCE",
    "Config": {
     "Port": 80,
     "Protocol": "HTTP",
     "VpcIdentifier": "vpc-4331593e"
    }
   }
  },
  "Lis": {
   "Type": "AWS::VpcLattice::Listener",
   "Properties": {
    "ServiceIdentifier": {
     "Ref": "Svc"
    },
    "Protocol": "TLS_PASSTHROUGH",
    "DefaultAction": {
     "Forward": {
      "TargetGroups": [
       {
        "TargetGroupIdentifier": {
         "Ref": "TG"
        }
       }
      ]
     }
    },
    "Port": 443
   }
  }
 }
}
