     },
     {
      "Fn::GetAtt": [
       "Sg1",
       "GroupId"
      ]
     },
     {
      "Fn::GetAtt": [
       "Sg2",
       "GroupId"
      ]
     },
     {
      "Fn::GetAtt": [
       "Sg3",
       "GroupId"
      ]
     },
     {
      "Fn::GetAtt": [
       "Sg4",
       "GroupId"
      ]
     }
    ]
