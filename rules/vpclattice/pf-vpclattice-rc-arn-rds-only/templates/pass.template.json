{
 "AWSTemplateFormatVersion": "2010-09-09",
 "Resources": {
  "Gw": {
   "Type": "AWS::VpcLattice::ResourceGateway",
   "Properties": {
    "Name": "cdkpf-363-s4-04-p-g",
    "VpcIdentifier": "vpc-4331593e",
    "SubnetIds": [
     "subnet-2e0a500f",
     "subnet-ab11fde7"
    ],
    "SecurityGroupIds": [
     "sg-7d699f61"
    ]
   }
  },
  "R": {
   "Type": "AWS::VpcLattice::ResourceConfiguration",
   "Properties": {
    "Name": "cdkpf-363-s4-04-p-r",
    "ResourceConfigurationType": "ARN",
    "ResourceGatewayId": {
     "Fn::GetAtt": [
      "Gw",
      "Id"
     ]
    },
    "ResourceConfigurationDefinition": {
     "ArnResource": {
      "Fn::GetAtt": [
       "Db",
       "DBInstanceArn"
      ]
     }
    }
   }
  },
  "Db": {
   "Type": "AWS::RDS::DBInstance",
   "DeletionPolicy": "Delete",
   "UpdateReplacePolicy": "Delete",
   "Properties": {
    "Engine": "postgres",
    "DBInstanceClass": "db.t4g.micro",
    "AllocatedStorage": "20",
    "MasterUsername": "benchuser",
    "ManageMasterUserPassword": true,
    "BackupRetentionPeriod": 0,
    "DeleteAutomatedBackups": true,
    "PubliclyAccessible": false
   }
  }
 }
}
