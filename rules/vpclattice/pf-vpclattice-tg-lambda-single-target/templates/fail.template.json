     ]
    },
    "Code": {
     "ZipFile": "def handler(event, context):\n    return {'statusCode': 200, 'body': 'ok'}\n"
    }
   }
  },
  "TG": {
   "Type": "AWS::VpcLattice::TargetGroup",
   "Properties": {
    "Name": "cdkpf-363-r12-f",
    "Type": "LAMBDA",
    "Targets": [
     {
      "Id": {
       "Fn::GetAtt": [
        "Fn",
        "Arn"
       ]
      }
     },
