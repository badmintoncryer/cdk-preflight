{
 "AWSTemplateFormatVersion": "2010-09-09",
 "Resources": {
  "V": {
   "Type": "AWS::EC2::VPC",
   "Properties": {
    "CidrBlock": "10.99.0.0/16",
    "EnableDnsSupport": true,
    "EnableDnsHostnames": true
   }
  },
  "S4": {
   "Type": "AWS::EC2::Subnet",
   "Properties": {
    "VpcId": {
     "Ref": "V"
    },
    "CidrBlock": "10.99.0.0/24",
    "AvailabilityZoneId": "use1-az2"
   }
  },
  "Sg": {
   "Type": "AWS::EC2::SecurityGroup",
   "Properties": {
    "GroupDescription": "cdkpf #363 resource gateway",
    "VpcId": {
     "Ref": "V"
    }
   }
  },
  "V6": {
   "Type": "AWS::EC2::VPCCidrBlock",
   "Properties": {
    "VpcId": {
     "Ref": "V"
    },
    "AmazonProvidedIpv6CidrBlock": true
   }
  },
  "Gw": {
   "Type": "AWS::VpcLattice::ResourceGateway",
   "Properties": {
    "Name": "cdkpf-363-s5-13-f-g",
    "VpcIdentifier": {
     "Ref": "V"
    },
    "SubnetIds": [
     {
      "Ref": "S4"
     }
    ],
    "SecurityGroupIds": [
     {
      "Fn::GetAtt": [
       "Sg",
       "GroupId"
      ]
     }
    ],
    "IpAddressType": "IPV6"
   },
   "DependsOn": [
    "V6"
   ]
  }
 }
}
