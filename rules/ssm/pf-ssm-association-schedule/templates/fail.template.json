          ]
        },
        "ScheduleExpression": "rate(29 minutes)",
        "AssociationName": "cdkpf-rate"
      }
    },
    "A2": {
      "Type": "AWS::SSM::Association",
      "Properties": {
        "Name": "AWS-RunShellScript",
        "Targets": [
          {
            "Key": "tag:cdkpf",
            "Values": [
              "probe"
            ]
          }
        ],
        "Parameters": {
          "commands": [
            "echo hi"
          ]
        },
        "ScheduleExpression": "cron(0 0 ? * TUE#6 *)",
