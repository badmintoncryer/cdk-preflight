{
  "Resources": {
    "Doc": {
      "Type": "AWS::SSM::Document",
      "Properties": {
        "DocumentType": "Automation",
        "Content": {
          "schemaVersion": "0.3",
          "description": "cdk-preflight probe: sleeps one second",
          "parameters": {
            "InstanceId": {
              "type": "String",
              "default": ""
            },
            "AutomationAssumeRole": {
              "type": "String",
              "default": ""
            }
          },
          "mainSteps": [
            {
              "name": "sleep",
              "action": "aws:sleep",
              "inputs": {
                "Duration": "PT1S"
              }
            }
          ],
          "assumeRole": "{{ AutomationAssumeRole }}"
        }
      }
    },
    "A": {
      "Type": "AWS::SSM::Association",
      "Properties": {
        "Name": {
          "Ref": "Doc"
        },
        "AutomationTargetParameterName": "InstanceId",
        "Targets": [
          {
            "Key": "tag:cdkpf",
            "Values": [
              "probe-1",
              "probe-2"
            ]
          }
        ],
        "WaitForSuccessTimeoutSeconds": 300,
        "Parameters": {
          "AutomationAssumeRole": [
            {
              "Fn::GetAtt": [
                "Role",
                "Arn"
              ]
            }
          ]
        }
      }
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ssm.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    }
  }
}
