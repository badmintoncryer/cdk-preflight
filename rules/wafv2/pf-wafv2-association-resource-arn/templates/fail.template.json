{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "W": {
      "Type": "AWS::WAFv2::WebACL",
      "Properties": {
        "Name": "cdkpf-w-associationresourcearn",
        "Scope": "REGIONAL",
        "DefaultAction": {
          "Allow": {}
        },
        "VisibilityConfig": {
          "SampledRequestsEnabled": false,
          "CloudWatchMetricsEnabled": false,
          "MetricName": "w"
        },
        "Rules": []
      }
    },
    "A": {
      "Type": "AWS::WAFv2::WebACLAssociation",
      "Properties": {
        "ResourceArn": "arn:aws:cloudfront::214794239830:distribution/E1234567890ABC",
        "WebACLArn": {
          "Fn::GetAtt": [
            "W",
            "Arn"
          ]
        }
      }
    }
  }
}
