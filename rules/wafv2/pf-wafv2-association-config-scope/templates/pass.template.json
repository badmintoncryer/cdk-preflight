{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "W": {
      "Type": "AWS::WAFv2::WebACL",
      "Properties": {
        "Name": "cdkpf-w-associationconfigscope",
        "Scope": "REGIONAL",
        "DefaultAction": {
          "Allow": {}
        },
        "VisibilityConfig": {
          "SampledRequestsEnabled": false,
          "CloudWatchMetricsEnabled": false,
          "MetricName": "w"
        },
        "Rules": [],
        "AssociationConfig": {
          "RequestBody": {
            "API_GATEWAY": {
              "DefaultSizeInspectionLimit": "KB_32"
            }
          }
        }
      }
    }
  }
}
