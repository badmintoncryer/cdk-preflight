{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "W": {
      "Type": "AWS::WAFv2::WebACL",
      "Properties": {
        "Name": "cdkpf-w-regexsyntax",
        "Scope": "REGIONAL",
        "DefaultAction": {
          "Allow": {}
        },
        "VisibilityConfig": {
          "SampledRequestsEnabled": false,
          "CloudWatchMetricsEnabled": false,
          "MetricName": "w"
        },
        "Rules": [
          {
            "Name": "r1",
            "Priority": 1,
            "Statement": {
              "RegexMatchStatement": {
                "RegexString": "(a)\\1",
                "FieldToMatch": {
                  "UriPath": {}
                },
                "TextTransformations": [
                  {
                    "Priority": 0,
                    "Type": "NONE"
                  }
                ]
              }
            },
            "Action": {
              "Block": {}
            },
            "VisibilityConfig": {
              "SampledRequestsEnabled": false,
              "CloudWatchMetricsEnabled": false,
              "MetricName": "r1"
            }
          }
        ]
      }
    }
  }
}
