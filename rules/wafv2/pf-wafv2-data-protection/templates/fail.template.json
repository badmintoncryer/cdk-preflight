{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "W": {
      "Type": "AWS::WAFv2::WebACL",
      "Properties": {
        "Name": "cdkpf-w-dataprotection",
        "Scope": "REGIONAL",
        "DefaultAction": {
          "Allow": {}
        },
        "VisibilityConfig": {
          "SampledRequestsEnabled": false,
          "CloudWatchMetricsEnabled": false,
          "MetricName": "w"
        },
        "Rules": [],
        "DataProtectionConfig": {
          "DataProtections": [
            {
              "Field": {
                "FieldType": "SINGLE_HEADER"
              },
              "Action": "HASH"
            }
          ]
        }
      }
    }
  }
}
