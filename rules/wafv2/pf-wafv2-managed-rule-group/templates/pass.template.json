{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "W": {
      "Type": "AWS::WAFv2::WebACL",
      "Properties": {
        "Name": "cdkpf-w-managedrulegroup",
        "Scope": "REGIONAL",
        "DefaultAction": {
          "Allow": {}
        },
        "VisibilityConfig": {
          "SampledRequestsEnabled": false,
          "CloudWatchMetricsEnabled": false,
          "MetricName": "w"
        },
        "Rules": [
          {
            "Name": "r1",
            "Priority": 1,
            "Statement": {
              "ManagedRuleGroupStatement": {
                "VendorName": "AWS",
                "Name": "AWSManagedRulesAntiDDoSRuleSet",
                "ManagedRuleGroupConfigs": [
                  {
                    "AWSManagedRulesAntiDDoSRuleSet": {
                      "ClientSideActionConfig": {
                        "Challenge": {
                          "UsageOfAction": "ENABLED",
                          "Sensitivity": "HIGH",
                          "ExemptUriRegularExpressions": [
                            {
                              "RegexString": "/health0"
                            },
                            {
                              "RegexString": "/health1"
                            },
                            {
                              "RegexString": "/health2"
                            },
                            {
                              "RegexString": "/health3"
                            },
                            {
                              "RegexString": "/health4"
                            }
                          ]
                        }
                      },
                      "SensitivityToBlock": "LOW"
                    }
                  }
                ]
              }
            },
            "OverrideAction": {
              "None": {}
            },
            "VisibilityConfig": {
              "SampledRequestsEnabled": false,
              "CloudWatchMetricsEnabled": false,
              "MetricName": "r1"
            }
          }
        ]
      }
    }
  }
}
