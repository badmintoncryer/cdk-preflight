{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "W": {
      "Type": "AWS::WAFv2::WebACL",
      "Properties": {
        "Name": "cdkpf-w-customrequesthandling",
        "Scope": "REGIONAL",
        "DefaultAction": {
          "Allow": {}
        },
        "VisibilityConfig": {
          "SampledRequestsEnabled": false,
          "CloudWatchMetricsEnabled": false,
          "MetricName": "w"
        },
        "Rules": [
          {
            "Name": "r1",
            "Priority": 1,
            "Statement": {
              "GeoMatchStatement": {
                "CountryCodes": [
                  "AQ"
                ]
              }
            },
            "Action": {
              "Count": {
                "CustomRequestHandling": {
                  "InsertHeaders": [
                    {
                      "Name": "a",
                      "Value": "1"
                    },
                    {
                      "Name": "b",
                      "Value": "2"
                    }
                  ]
                }
              }
            },
            "VisibilityConfig": {
              "SampledRequestsEnabled": false,
              "CloudWatchMetricsEnabled": false,
              "MetricName": "r1"
            }
          }
        ]
      }
    }
  }
}
