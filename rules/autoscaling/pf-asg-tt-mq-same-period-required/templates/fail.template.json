{
  "Resources": {
    "LT": {
      "Type": "AWS::EC2::LaunchTemplate",
      "Properties": {
        "LaunchTemplateData": {
          "ImageId": "{{resolve:ssm:/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64}}",
          "InstanceType": "t3.micro"
        }
      }
    },
    "G": {
      "Type": "AWS::AutoScaling::AutoScalingGroup",
      "Properties": {
        "MinSize": "0",
        "MaxSize": "1",
        "AvailabilityZones": [
          "us-east-1a"
        ],
        "LaunchTemplate": {
          "LaunchTemplateId": {
            "Ref": "LT"
          },
          "Version": {
            "Fn::GetAtt": [
              "LT",
              "LatestVersionNumber"
            ]
          }
        }
      }
    },
    "R": {
      "Type": "AWS::AutoScaling::ScalingPolicy",
      "Properties": {
        "AutoScalingGroupName": {
          "Ref": "G"
        },
        "PolicyType": "TargetTrackingScaling",
        "TargetTrackingConfiguration": {
          "TargetValue": 50,
          "CustomizedMetricSpecification": {
            "Metrics": [
              {
                "Id": "m1",
                "MetricStat": {
                  "Metric": {
                    "Namespace": "cdkpf",
                    "MetricName": "probe"
                  },
                  "Stat": "Average",
                  "Period": 10
                },
                "ReturnData": false
              },
              {
                "Id": "m2",
                "MetricStat": {
                  "Metric": {
                    "Namespace": "cdkpf",
                    "MetricName": "probe"
                  },
                  "Stat": "Average",
                  "Period": 60
                },
                "ReturnData": true
              }
            ]
          }
        }
      }
    }
  }
}
