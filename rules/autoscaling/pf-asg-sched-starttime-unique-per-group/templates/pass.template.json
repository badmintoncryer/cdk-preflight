{
  "Resources": {
    "LT": {
      "Type": "AWS::EC2::LaunchTemplate",
      "Properties": {
        "LaunchTemplateData": {
          "ImageId": "{{resolve:ssm:/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64}}",
          "InstanceType": "t3.micro"
        }
      }
    },
    "G": {
      "Type": "AWS::AutoScaling::AutoScalingGroup",
      "Properties": {
        "MinSize": "0",
        "MaxSize": "1",
        "AvailabilityZones": [
          "us-east-1a"
        ],
        "LaunchTemplate": {
          "LaunchTemplateId": {
            "Ref": "LT"
          },
          "Version": {
            "Fn::GetAtt": [
              "LT",
              "LatestVersionNumber"
            ]
          }
        }
      }
    },
    "R": {
      "Type": "AWS::AutoScaling::ScheduledAction",
      "Properties": {
        "AutoScalingGroupName": {
          "Ref": "G"
        },
        "MinSize": 0,
        "MaxSize": 1,
        "DesiredCapacity": 0,
        "StartTime": "2099-01-01T00:00:00Z"
      }
    },
    "R2": {
      "Type": "AWS::AutoScaling::ScheduledAction",
      "Properties": {
        "AutoScalingGroupName": {
          "Ref": "G"
        },
        "DesiredCapacity": 1,
        "StartTime": "2098-01-01T00:00:00Z"
      }
    }
  }
}
