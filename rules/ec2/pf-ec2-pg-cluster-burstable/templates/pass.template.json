{
  "Resources": {
    "P": {
      "Type": "AWS::EC2::PlacementGroup",
      "Properties": {
        "Strategy": "cluster"
      }
    },
    "I": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "InstanceType": "c5.large",
        "ImageId": "{{resolve:ssm:/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64}}",
        "PlacementGroupName": {
          "Ref": "P"
        }
      }
    }
  }
}
