{
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.1.0.0/16"
      }
    },
    "Src": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "cdkpf source group",
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "G": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "cdkpf source exclusive fixture",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "10.1.0.0/24",
            "SourceSecurityGroupId": {
              "Ref": "Src"
            }
          }
        ]
      }
    }
  }
}
