{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.80.0.0/16"
      }
    },
    "Subnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.80.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        }
      }
    },
    "Igw": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {}
    },
    "Attach": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "Igw"
        }
      }
    },
    "Eip": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc"
      }
    },
    "Eni": {
      "Type": "AWS::EC2::NetworkInterface",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet"
        }
      }
    },
    "Assoc": {
      "Type": "AWS::EC2::EIPAssociation",
      "DependsOn": "Attach",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "Eip",
            "AllocationId"
          ]
        },
        "EIP": {
          "Ref": "Eip"
        },
        "NetworkInterfaceId": {
          "Ref": "Eni"
        }
      }
    }
  }
}
