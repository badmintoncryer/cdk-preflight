{
  "Resources": {
    "Endpoint": {
      "Type": "AWS::EC2::ClientVpnEndpoint",
      "Properties": {
        "AuthenticationOptions": [
          {
            "Type": "certificate-authentication",
            "MutualAuthentication": {
              "ClientRootCertificateChainArn": "{{resolve:ssm:/cdkpf/fixtures/acm/cdkpf-appnao-com}}"
            }
          }
        ],
        "ClientCidrBlock": "10.100.0.0/22",
        "ConnectionLogOptions": {
          "Enabled": false
        },
        "ServerCertificateArn": "{{resolve:ssm:/cdkpf/fixtures/acm/cdkpf-appnao-com}}"
      }
    },
    "Rule": {
      "Type": "AWS::EC2::ClientVpnAuthorizationRule",
      "Properties": {
        "ClientVpnEndpointId": {
          "Ref": "Endpoint"
        },
        "TargetNetworkCidr": "10.200.0.0/16",
        "AuthorizeAllGroups": true,
        "AccessGroupId": "cdkpf-group"
      }
    }
  }
}