{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "Vol": {
      "Type": "AWS::EC2::Volume",
      "DeletionPolicy": "Delete",
      "Properties": {
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "Size": 8,
        "VolumeType": "io2",
        "Iops": 100,
        "MultiAttachEnabled": true
      }
    }
  }
}
