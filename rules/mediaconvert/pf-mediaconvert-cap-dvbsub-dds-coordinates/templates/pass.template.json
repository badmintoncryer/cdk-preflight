{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "Mc": {
      "Type": "AWS::MediaConvert::Preset",
      "Properties": {
        "Name": "cdkpf-mc-preset",
        "SettingsJson": {
          "ContainerSettings": {
            "Container": "M2TS",
            "M2tsSettings": {}
          },
          "VideoDescription": {
            "Width": 1280,
            "Height": 720,
            "CodecSettings": {
              "Codec": "H_264",
              "H264Settings": {
                "RateControlMode": "CBR",
                "Bitrate": 2000000
              }
            }
          },
          "AudioDescriptions": [
            {
              "CodecSettings": {
                "Codec": "AAC",
                "AacSettings": {
                  "Bitrate": 96000,
                  "CodingMode": "CODING_MODE_2_0",
                  "SampleRate": 48000
                }
              }
            }
          ],
          "CaptionDescriptions": [
            {
              "LanguageCode": "ENG",
              "DestinationSettings": {
                "DestinationType": "DVB_SUB",
                "DvbSubDestinationSettings": {
                  "DdsHandling": "SPECIFIED",
                  "DdsXCoordinate": 10,
                  "DdsYCoordinate": 10
                }
              }
            }
          ]
        }
      }
    }
  }
}
