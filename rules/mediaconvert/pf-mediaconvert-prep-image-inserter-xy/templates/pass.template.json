{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "Mc": {
      "Type": "AWS::MediaConvert::Preset",
      "Properties": {
        "Name": "cdkpf-mc-preset",
        "SettingsJson": {
          "ContainerSettings": {
            "Container": "MP4"
          },
          "VideoDescription": {
            "Width": 1280,
            "Height": 720,
            "CodecSettings": {
              "Codec": "H_264",
              "H264Settings": {
                "RateControlMode": "CBR",
                "Bitrate": 2000000
              }
            },
            "VideoPreprocessors": {
              "ImageInserter": {
                "InsertableImages": [
                  {
                    "ImageInserterInput": "s3://cdkpf-mc-bucket/logo.png",
                    "Layer": 1,
                    "Opacity": 50,
                    "ImageX": 0,
                    "ImageY": 0
                  }
                ]
              }
            }
          },
          "AudioDescriptions": [
            {
              "CodecSettings": {
                "Codec": "AAC",
                "AacSettings": {
                  "Bitrate": 96000,
                  "CodingMode": "CODING_MODE_2_0",
                  "SampleRate": 48000
                }
              }
            }
          ]
        }
      }
    }
  }
}
