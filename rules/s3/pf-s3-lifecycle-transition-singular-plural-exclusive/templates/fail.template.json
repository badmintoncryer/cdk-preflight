{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "B": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "r1",
              "Status": "Enabled",
              "Transition": {
                "StorageClass": "GLACIER",
                "TransitionInDays": 90
              },
              "Transitions": [
                {
                  "StorageClass": "STANDARD_IA",
                  "TransitionInDays": 30
                }
              ]
            }
          ]
        }
      }
    }
  }
}
