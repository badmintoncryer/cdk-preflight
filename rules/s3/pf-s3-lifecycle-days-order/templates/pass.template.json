{
  "Resources": {
    "Bucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "tiering",
              "Status": "Enabled",
              "ExpirationInDays": 120,
              "Transitions": [
                { "StorageClass": "STANDARD_IA", "TransitionInDays": 30 },
                { "StorageClass": "GLACIER", "TransitionInDays": 60 }
              ]
            }
          ]
        }
      }
    }
  }
}
