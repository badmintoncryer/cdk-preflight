{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "B": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "r1",
              "Status": "Enabled",
              "ExpirationInDays": 365,
              "Transitions": [
                {
                  "StorageClass": "GLACIER",
                  "TransitionDate": "2030-01-01T00:00:00Z"
                }
              ]
            }
          ]
        }
      }
    }
  }
}
