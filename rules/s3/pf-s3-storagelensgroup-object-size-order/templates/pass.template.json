{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "G": {
      "Type": "AWS::S3::StorageLensGroup",
      "Properties": {
        "Name": "cdkpf-s3sgs",
        "Filter": {
          "MatchObjectSize": {
            "BytesGreaterThan": 1000,
            "BytesLessThan": 5000
          }
        }
      }
    }
  }
}
