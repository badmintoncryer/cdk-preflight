{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "B": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "r1",
              "Status": "Enabled",
              "ExpirationInDays": 30,
              "TagFilters": [
                {
                  "Key": "env",
                  "Value": "dev"
                },
                {
                  "Key": "env",
                  "Value": "prod"
                }
              ]
            }
          ]
        }
      }
    }
  }
}
