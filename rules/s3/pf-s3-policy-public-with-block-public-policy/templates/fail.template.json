{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "B": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": "cdkpf-s3pbp-b0",
        "PublicAccessBlockConfiguration": {
          "BlockPublicPolicy": true
        }
      }
    },
    "P": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "B"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "Public",
              "Effect": "Allow",
              "Principal": "*",
              "Action": "s3:GetObject",
              "Resource": "arn:aws:s3:::cdkpf-s3pbp-b0/*"
            }
          ]
        }
      }
    }
  }
}
