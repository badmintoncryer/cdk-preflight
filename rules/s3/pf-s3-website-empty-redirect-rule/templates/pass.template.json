{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "B": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "WebsiteConfiguration": {
          "IndexDocument": "index.html",
          "RoutingRules": [
            {
              "RedirectRule": {
                "HostName": "example.com"
              },
              "RoutingRuleCondition": {
                "KeyPrefixEquals": "docs/"
              }
            }
          ]
        }
      }
    }
  }
}
