{
  "Resources": {
    "B": {
      "Type": "AWS::S3::Bucket",
      "Properties": {}
    },
    "P": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "B"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${B.Arn}/*"
              }
            }
          ]
        }
      }
    }
  }
}
