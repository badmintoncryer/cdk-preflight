{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "B": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "ReplicationConfiguration": {
          "Role": {
            "Fn::GetAtt": [
              "PfRole",
              "Arn"
            ]
          },
          "Rules": [
            {
              "Status": "Enabled",
              "Priority": 1,
              "DeleteMarkerReplication": {
                "Status": "Disabled"
              },
              "Filter": {
                "Prefix": "logs/"
              },
              "Destination": {
                "Bucket": {
                  "Fn::GetAtt": [
                    "PfDest",
                    "Arn"
                  ]
                },
                "EncryptionConfiguration": {
                  "ReplicaKmsKeyID": {
                    "Fn::GetAtt": [
                      "PfKey",
                      "Arn"
                    ]
                  }
                }
              },
              "SourceSelectionCriteria": {
                "SseKmsEncryptedObjects": {
                  "Status": "Enabled"
                }
              }
            }
          ]
        }
      }
    },
    "PfRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "s3.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    },
    "PfDest": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "VersioningConfiguration": {
          "Status": "Enabled"
        }
      }
    },
    "PfKey": {
      "Type": "AWS::KMS::Key",
      "Properties": {
        "PendingWindowInDays": 7,
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:root"
                }
              },
              "Action": "kms:*",
              "Resource": "*"
            }
          ]
        }
      }
    }
  }
}
