{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "B": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "ObjectLockEnabled": true,
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "ObjectLockConfiguration": {
          "ObjectLockEnabled": "Enabled",
          "Rule": {
            "DefaultRetention": {
              "Mode": "GOVERNANCE",
              "Days": 30,
              "Years": 1
            }
          }
        }
      }
    }
  }
}
