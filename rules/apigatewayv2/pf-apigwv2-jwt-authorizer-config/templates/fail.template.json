{
  "Resources": {
    "Api": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": "p",
        "ProtocolType": "HTTP"
      }
    },
    "Auth": {
      "Type": "AWS::ApiGatewayV2::Authorizer",
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "Name": "auth",
        "AuthorizerType": "JWT",
        "IdentitySource": [
          "$request.header.Authorization"
        ]
      }
    }
  }
}
