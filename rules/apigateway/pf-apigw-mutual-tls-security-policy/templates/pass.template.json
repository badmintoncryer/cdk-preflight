{
  "Resources": {
    "X": {
      "Type": "AWS::ApiGateway::DomainName",
      "Properties": {
        "DomainName": "cdkpf-apigw-mtls.appnao.com",
        "EndpointConfiguration": {
          "Types": [
            "REGIONAL"
          ]
        },
        "RegionalCertificateArn": "{{resolve:ssm:/cdkpf/fixtures/acm/wildcard-appnao-com}}",
        "SecurityPolicy": "TLS_1_2",
        "MutualTlsAuthentication": {
          "TruststoreUri": {
            "Fn::Sub": "s3://cdkpf-fixtures-${AWS::AccountId}/ca.pem"
          }
        }
      }
    }
  }
}
