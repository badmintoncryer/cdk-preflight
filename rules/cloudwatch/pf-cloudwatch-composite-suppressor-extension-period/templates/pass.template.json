{
  "Resources": {
    "Supp": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "ComparisonOperator": "GreaterThanThreshold",
        "EvaluationPeriods": 1,
        "MetricName": "CPUUtilization",
        "Namespace": "AWS/EC2",
        "Statistic": "Average",
        "Period": 60,
        "Threshold": 1,
        "AlarmName": "pf-supp-sep"
      }
    },
    "Composite": {
      "Type": "AWS::CloudWatch::CompositeAlarm",
      "Properties": {
        "AlarmName": "pf-ca-sep",
        "AlarmRule": {
          "Fn::Sub": "ALARM(${Supp})"
        },
        "ActionsSuppressor": {
          "Ref": "Supp"
        },
        "ActionsSuppressorWaitPeriod": 60,
        "ActionsSuppressorExtensionPeriod": 60
      }
    }
  }
}
