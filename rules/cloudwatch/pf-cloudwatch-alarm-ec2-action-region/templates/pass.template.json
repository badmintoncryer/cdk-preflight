{
  "Resources": {
    "Alarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "ComparisonOperator": "GreaterThanThreshold",
        "EvaluationPeriods": 1,
        "MetricName": "CPUUtilization",
        "Namespace": "AWS/EC2",
        "Statistic": "Average",
        "Period": 60,
        "Threshold": 1,
        "AlarmActions": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:automate:${AWS::Region}:ec2:stop"
          }
        ],
        "Dimensions": [
          {
            "Name": "InstanceId",
            "Value": "i-0123456789abcdef0"
          }
        ]
      }
    }
  }
}
