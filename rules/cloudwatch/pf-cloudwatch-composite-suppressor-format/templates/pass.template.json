{
  "Resources": {
    "Child": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "ComparisonOperator": "GreaterThanThreshold",
        "EvaluationPeriods": 1,
        "MetricName": "CPUUtilization",
        "Namespace": "AWS/EC2",
        "Statistic": "Average",
        "Period": 60,
        "Threshold": 1,
        "AlarmName": "pf-child-sfmt"
      }
    },
    "Composite": {
      "Type": "AWS::CloudWatch::CompositeAlarm",
      "Properties": {
        "AlarmName": "pf-ca-sfmt",
        "AlarmRule": "ALARM(\"pf-child-sfmt\")",
        "ActionsSuppressor": {
          "Fn::GetAtt": [
            "Child",
            "Arn"
          ]
        },
        "ActionsSuppressorWaitPeriod": 60,
        "ActionsSuppressorExtensionPeriod": 60
      }
    }
  }
}
