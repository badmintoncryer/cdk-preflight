{
  "Resources": {
    "Stream": {
      "Type": "AWS::CloudWatch::MetricStream",
      "Properties": {
        "FirehoseArn": {
          "Fn::Sub": "arn:${AWS::Partition}:firehose:${AWS::Region}:999988887777:deliverystream/pf-stream"
        },
        "RoleArn": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/pf-metric-stream"
        },
        "OutputFormat": "json"
      }
    }
  }
}
