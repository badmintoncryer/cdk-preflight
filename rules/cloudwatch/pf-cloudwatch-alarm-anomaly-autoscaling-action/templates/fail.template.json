{
  "Resources": {
    "Alarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "ComparisonOperator": "LessThanLowerOrGreaterThanUpperThreshold",
        "EvaluationPeriods": 1,
        "Metrics": [
          {
            "Id": "m1",
            "ReturnData": true,
            "MetricStat": {
              "Metric": {
                "Namespace": "AWS/EC2",
                "MetricName": "CPUUtilization"
              },
              "Period": 60,
              "Stat": "Average"
            }
          },
          {
            "Id": "ad1",
            "ReturnData": true,
            "Expression": "ANOMALY_DETECTION_BAND(m1, 2)"
          }
        ],
        "ThresholdMetricId": "ad1",
        "AlarmActions": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:autoscaling:${AWS::Region}:${AWS::AccountId}:scalingPolicy:11111111-2222-3333-4444-555555555555:autoScalingGroupName/pf-asg:policyName/pf-policy"
          }
        ]
      }
    }
  }
}
