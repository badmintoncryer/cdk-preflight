{
  "Resources": {
    "Alarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "ComparisonOperator": "GreaterThanThreshold",
        "EvaluationPeriods": 1,
        "MetricName": "CPUUtilization",
        "Namespace": "AWS/EC2",
        "Period": 60,
        "Threshold": 1,
        "ExtendedStatistic": "p90",
        "EvaluateLowSampleCountPercentile": "ignore"
      }
    }
  }
}
