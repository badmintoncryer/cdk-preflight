{
  "Resources": {
    "Stream": {
      "Type": "AWS::CloudWatch::MetricStream",
      "Properties": {
        "FirehoseArn": {
          "Fn::Sub": "arn:${AWS::Partition}:firehose:${AWS::Region}:${AWS::AccountId}:deliverystream/pf-stream"
        },
        "RoleArn": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/pf-metric-stream"
        },
        "OutputFormat": "json",
        "StatisticsConfigurations": [
          {
            "AdditionalStatistics": [
              "p99"
            ],
            "IncludeMetrics": [
              {
                "Namespace": "AWS/EC2",
                "MetricName": "CPUUtilization"
              }
            ]
          }
        ]
      }
    }
  }
}
