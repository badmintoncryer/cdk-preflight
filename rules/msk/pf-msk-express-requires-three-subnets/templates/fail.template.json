{
  "Resources": {
    "Cluster": {
      "Type": "AWS::MSK::Cluster",
      "Properties": {
        "ClusterName": "cdkpf-msk-erts-fail",
        "KafkaVersion": "3.9.x.kraft",
        "NumberOfBrokerNodes": 2,
        "BrokerNodeGroupInfo": {
          "InstanceType": "express.m7g.large",
          "ClientSubnets": [
            "subnet-00000000000000001",
            "subnet-00000000000000002"
          ],
          "SecurityGroups": [
            "sg-00000000000000001"
          ]
        },
        "ClientAuthentication": {
          "Sasl": {
            "Iam": {
              "Enabled": true
            }
          }
        },
        "EncryptionInfo": {
          "EncryptionInTransit": {
            "ClientBroker": "TLS",
            "InCluster": true
          }
        }
      }
    }
  }
}
