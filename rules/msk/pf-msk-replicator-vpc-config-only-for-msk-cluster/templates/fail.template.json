                  "Fn::Sub": "arn:aws:secretsmanager:us-east-1:${AWS::AccountId}:secret:AmazonMSK_cdkpf-repl-abcdef"
                }
              }
            },
            "EncryptionInTransit": {
              "EncryptionType": "TLS"
