              ]
            }
          },
          {
            "AmazonMskCluster": {
              "MskClusterArn": {
                "Fn::Sub": "arn:aws:kafka:us-east-1:${AWS::AccountId}:cluster/cdkpf-tgt/22222222-3333-4444-5555-666666666666-2"
              }
            },
            "VpcConfig": {
              "SubnetIds": [
                "subnet-11111111111111111",
                "subnet-22222222222222222"
              ],
              "SecurityGroupIds": [
                "sg-11111111111111111"
              ]
            }
          }
        ],
        "ReplicationInfoList": [
          {
            "TargetKafkaClusterArn": {
              "Fn::Sub": "arn:aws:kafka:us-east-1:${AWS::AccountId}:cluster/cdkpf-tgt/22222222-3333-4444-5555-666666666666-2"
            },
            "TargetCompressionType": "NONE",
            "TopicReplication": {
              "TopicsToReplicate": [
                ".*"
              ]
            },
            "ConsumerGroupReplication": {
              "ConsumerGroupsToReplicate": [
                ".*"
              ]
            },
            "SourceKafkaClusterId": "cdkpfsrc"
          }
        ]
