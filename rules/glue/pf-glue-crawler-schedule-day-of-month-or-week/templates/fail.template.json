{
  "Resources": {
    "Main": {
      "Type": "AWS::Glue::Crawler",
      "Properties": {
        "Role": {
          "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/cdkpf-glue-probe"
        },
        "DatabaseName": "pfcrawldb",
        "Targets": {
          "S3Targets": [
            {
              "Path": {
                "Fn::Sub": "s3://cdkpf-fixtures-${AWS::AccountId}/in/"
              }
            }
          ]
        },
        "Schedule": {
          "ScheduleExpression": "cron(0 10 1 * MON 2099)"
        }
      }
    }
  }
}
