{
  "Resources": {
    "Main": {
      "Type": "AWS::Glue::Crawler",
      "Properties": {
        "Role": {
          "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/cdkpf-glue-probe"
        },
        "DatabaseName": "pfcrawldb",
        "Targets": {
          "DynamoDBTargets": [
            {
              "Path": "pfddbtbl",
              "ScanRate": 0.09
            },
            {
              "Path": "pfddbtbl",
              "ScanRate": 1.51
            }
          ]
        }
      }
    }
  }
}
