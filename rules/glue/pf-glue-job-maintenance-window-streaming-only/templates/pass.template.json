{
  "Resources": {
    "Main": {
      "Type": "AWS::Glue::Job",
      "Properties": {
        "Role": {
          "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/cdkpf-glue-probe"
        },
        "GlueVersion": "4.0",
        "Command": {
          "Name": "gluestreaming",
          "ScriptLocation": {
            "Fn::Sub": "s3://cdkpf-fixtures-${AWS::AccountId}/s.py"
          },
          "PythonVersion": "3"
        },
        "WorkerType": "G.1X",
        "NumberOfWorkers": 2,
        "MaintenanceWindow": "Sun:23"
      }
    }
  }
}
