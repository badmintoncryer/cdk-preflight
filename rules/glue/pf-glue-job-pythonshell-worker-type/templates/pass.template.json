{
  "Resources": {
    "Main": {
      "Type": "AWS::Glue::Job",
      "Properties": {
        "Role": {
          "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/cdkpf-glue-probe"
        },
        "Command": {
          "Name": "pythonshell",
          "ScriptLocation": {
            "Fn::Sub": "s3://cdkpf-fixtures-${AWS::AccountId}/s.py"
          },
          "PythonVersion": "3.9"
        },
        "MaxCapacity": 1
      }
    }
  }
}
