{
  "Resources": {
    "A": {
      "Type": "AWS::Glue::Classifier",
      "Properties": {
        "CsvClassifier": {
          "Delimiter": ",",
          "QuoteSymbol": "\"",
          "ContainsCustomDatatype": [
            "STRING"
          ],
          "Name": {
            "Fn::Sub": "${AWS::StackName}-a"
          }
        }
      }
    },
    "B": {
      "Type": "AWS::Glue::Classifier",
      "Properties": {
        "CsvClassifier": {
          "Delimiter": ",",
          "QuoteSymbol": "\"",
          "CustomDatatypeConfigured": true,
          "Name": {
            "Fn::Sub": "${AWS::StackName}-b"
          }
        }
      }
    }
  }
}
