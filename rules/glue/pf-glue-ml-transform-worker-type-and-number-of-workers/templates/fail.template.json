{
  "Resources": {
    "Db": {
      "Type": "AWS::Glue::Database",
      "Properties": {
        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "DatabaseInput": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}"
          }
        }
      }
    },
    "Tbl": {
      "Type": "AWS::Glue::Table",
      "Properties": {
        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "DatabaseName": {
          "Ref": "Db"
        },
        "TableInput": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-t"
          },
          "TableType": "EXTERNAL_TABLE",
          "StorageDescriptor": {
            "Location": "s3://cdkpf-glue-probe-214794239830/t/",
            "Columns": [
              {
                "Name": "c1",
                "Type": "string"
              },
              {
                "Name": "c2",
                "Type": "string"
              }
            ]
          }
        }
      }
    },
    "NoWorkers": {
      "Type": "AWS::Glue::MLTransform",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-m1"
        },
        "Role": "arn:aws:iam::214794239830:role/cdkpf-glue-probe",
        "InputRecordTables": {
          "GlueTables": [
            {
              "DatabaseName": {
                "Ref": "Db"
              },
              "TableName": {
                "Ref": "Tbl"
              }
            }
          ]
        },
        "TransformParameters": {
          "TransformType": "FIND_MATCHES",
          "FindMatchesParameters": {
            "PrimaryKeyColumnName": "c1"
          }
        },
        "WorkerType": "G.1X"
      }
    },
    "NoType": {
      "Type": "AWS::Glue::MLTransform",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-m2"
        },
        "Role": "arn:aws:iam::214794239830:role/cdkpf-glue-probe",
        "InputRecordTables": {
          "GlueTables": [
            {
              "DatabaseName": {
                "Ref": "Db"
              },
              "TableName": {
                "Ref": "Tbl"
              }
            }
          ]
        },
        "TransformParameters": {
          "TransformType": "FIND_MATCHES",
          "FindMatchesParameters": {
            "PrimaryKeyColumnName": "c1"
          }
        },
        "NumberOfWorkers": 2
      }
    }
  }
}
