{
  "Resources": {
    "Db": {
      "Type": "AWS::Glue::Database",
      "Properties": {
        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "DatabaseInput": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}"
          }
        }
      }
    },
    "Tbl": {
      "Type": "AWS::Glue::Table",
      "Properties": {
        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "DatabaseName": {
          "Ref": "Db"
        },
        "TableInput": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-t"
          },
          "TableType": "EXTERNAL_TABLE",
          "StorageDescriptor": {
            "Location": {
              "Fn::Sub": "s3://cdkpf-fixtures-${AWS::AccountId}/t/"
            },
            "Columns": [
              {
                "Name": "c1",
                "Type": "string"
              },
              {
                "Name": "c2",
                "Type": "string"
              }
            ]
          }
        }
      }
    },
    "Main": {
      "Type": "AWS::Glue::MLTransform",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-m"
        },
        "Role": {
          "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/cdkpf-glue-probe"
        },
        "InputRecordTables": {
          "GlueTables": [
            {
              "DatabaseName": {
                "Ref": "Db"
              },
              "TableName": {
                "Ref": "Tbl"
              }
            }
          ]
        },
        "TransformParameters": {
          "TransformType": "FIND_MATCHES",
          "FindMatchesParameters": {
            "PrimaryKeyColumnName": "c1"
          }
        },
        "WorkerType": "G.1X",
        "NumberOfWorkers": 2,
        "GlueVersion": "2.0"
      }
    }
  }
}
