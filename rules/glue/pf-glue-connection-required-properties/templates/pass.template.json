{
  "Resources": {
    "Jdbc": {
      "Type": "AWS::Glue::Connection",
      "Properties": {
        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "ConnectionInput": {
          "ConnectionType": "JDBC",
          "ConnectionProperties": {
            "JDBC_CONNECTION_URL": "jdbc:mysql://db.example.com:3306/d",
            "USERNAME": "u",
            "PASSWORD": "p"
          }
        }
      }
    },
    "Kafka": {
      "Type": "AWS::Glue::Connection",
      "Properties": {
        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "ConnectionInput": {
          "ConnectionType": "KAFKA",
