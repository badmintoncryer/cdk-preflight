        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "ConnectionInput": {
          "ConnectionType": "CUSTOM",
          "ConnectionProperties": {
            "CONNECTOR_URL": "s3://cdkpf-glue-probe-214794239830/c.jar",
            "CONNECTOR_TYPE": "Jdbc",
            "CONNECTOR_CLASS_NAME": "com.example.Driver"
          }
        }
      }
    },
    "Marketplace": {
      "Type": "AWS::Glue::Connection",
      "Properties": {
        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "ConnectionInput": {
          "ConnectionType": "MARKETPLACE",
          "ConnectionProperties": {
            "CONNECTOR_URL": "s3://cdkpf-glue-probe-214794239830/c.jar",
            "CONNECTOR_TYPE": "Jdbc",
            "CONNECTOR_CLASS_NAME": "com.example.Driver"
          }
        }
