{
  "Resources": {
    "Db": {
      "Type": "AWS::Glue::Database",
      "Properties": {
        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "DatabaseInput": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}"
          }
        }
      }
    },
    "Main": {
      "Type": "AWS::Glue::UserDefinedFunction",
      "Properties": {
        "DatabaseName": {
          "Ref": "Db"
        },
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-f"
        },
        "ClassName": "C",
        "OwnerName": "o",
        "OwnerType": "USER"
      }
    }
  }
}
