{
  "Resources": {
    "Conn": {
      "Type": "AWS::Glue::Connection",
      "Properties": {
        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "ConnectionInput": {
          "ConnectionType": "JDBC",
          "ConnectionProperties": {
            "JDBC_CONNECTION_URL": "jdbc:mysql://db.example.com:3306/d",
            "USERNAME": "u",
            "PASSWORD": "p"
          }
        }
      }
    },
    "Main": {
      "Type": "AWS::Glue::Crawler",
      "Properties": {
        "Role": {
          "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/cdkpf-glue-probe"
        },
        "DatabaseName": "pfcrawldb",
        "Targets": {
          "JdbcTargets": [
            {
              "ConnectionName": {
                "Ref": "Conn"
              },
              "Path": "d/%"
            }
          ]
        },
        "RecrawlPolicy": {
          "RecrawlBehavior": "CRAWL_NEW_FOLDERS_ONLY"
        }
      }
    }
  }
}
