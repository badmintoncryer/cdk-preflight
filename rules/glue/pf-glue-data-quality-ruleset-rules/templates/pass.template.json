{
  "Resources": {
    "Db": {
      "Type": "AWS::Glue::Database",
      "Properties": {
        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "DatabaseInput": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}"
          }
        }
      }
    },
    "Tbl": {
      "Type": "AWS::Glue::Table",
      "Properties": {
        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "DatabaseName": {
          "Ref": "Db"
        },
        "TableInput": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-t"
          },
          "TableType": "EXTERNAL_TABLE",
          "StorageDescriptor": {
            "Location": {
              "Fn::Sub": "s3://cdkpf-fixtures-${AWS::AccountId}/t/"
            },
            "Columns": [
              {
                "Name": "c1",
                "Type": "string"
              },
              {
                "Name": "c2",
                "Type": "string"
              }
            ]
          }
        }
      }
    },
    "Main": {
      "Type": "AWS::Glue::DataQualityRuleset",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}"
        },
        "Ruleset": "Rules = [ RowCount > 0 ]",
        "TargetTable": {
          "DatabaseName": {
            "Ref": "Db"
          },
          "TableName": {
            "Ref": "Tbl"
          }
        }
      }
    }
  }
}
